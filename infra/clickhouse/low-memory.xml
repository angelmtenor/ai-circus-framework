<!-- Laptop-class ClickHouse settings for Langfuse — mounted by docker-compose.yml's
     clickhouse service. Mirrors k8s/base/langfuse.yaml's clickhouse-config ConfigMap
     exactly; keep the two in sync by hand. -->
<clickhouse>
    <!-- Langfuse requires UTC (it compares ClickHouse and Postgres timestamps). -->
    <timezone>UTC</timezone>
    <logger><level>warning</level><console>1</console></logger>
    <!-- Relative to the cgroup limit (resources.limits.memory), not host RAM. -->
    <max_server_memory_usage_to_ram_ratio>0.8</max_server_memory_usage_to_ram_ratio>
    <mark_cache_size>134217728</mark_cache_size>
    <index_mark_cache_size>33554432</index_mark_cache_size>
    <uncompressed_cache_size>0</uncompressed_cache_size>
    <max_concurrent_queries>32</max_concurrent_queries>
    <!-- Merge/mutation pool sizes are left at their defaults on purpose: ClickHouse refuses
             to start when background_pool_size * background_merges_mutations_concurrency_ratio
             drops below number_of_free_entries_in_pool_to_execute_mutation (20). -->
        <max_thread_pool_size>256</max_thread_pool_size>
    <background_schedule_pool_size>16</background_schedule_pool_size>
    <background_fetches_pool_size>2</background_fetches_pool_size>
    <background_common_pool_size>4</background_common_pool_size>
    <!-- ClickHouse's own diagnostics tables (trace_log, text_log, part_log, metric_log, …) are
         on by default and, on an idle Langfuse, grew to ~2 GiB on disk against ~15 MiB of real
         traces while their inserts/merges kept the server near one full core. Nobody reads
         them here, so every one is removed (crash_log stays: it only writes on a crash).
         After a config change an existing cluster keeps the old tables until they are dropped. -->
    <aggregated_zookeeper_log remove="1"/>
    <asynchronous_insert_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <background_schedule_pool_log remove="1"/>
    <backup_log remove="1"/>
    <blob_storage_log remove="1"/>
    <delta_lake_metadata_log remove="1"/>
    <error_log remove="1"/>
    <histogram_metric_log remove="1"/>
    <iceberg_metadata_log remove="1"/>
    <instrumentation_trace_log remove="1"/>
    <latency_log remove="1"/>
    <metric_log remove="1"/>
    <opentelemetry_span_log remove="1"/>
    <part_log remove="1"/>
    <processors_profile_log remove="1"/>
    <query_log remove="1"/>
    <query_metric_log remove="1"/>
    <query_thread_log remove="1"/>
    <query_views_log remove="1"/>
    <session_log remove="1"/>
    <text_log remove="1"/>
    <trace_log remove="1"/>
    <zookeeper_connection_log remove="1"/>
    <zookeeper_log remove="1"/>
</clickhouse>
