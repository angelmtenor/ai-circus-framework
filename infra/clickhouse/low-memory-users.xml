<!-- Laptop-class ClickHouse settings for Langfuse — mounted by docker-compose.yml's
     clickhouse service. Mirrors k8s/base/langfuse.yaml's clickhouse-config ConfigMap
     exactly; keep the two in sync by hand. -->
<clickhouse>
    <profiles>
        <default>
            <max_memory_usage>268435456</max_memory_usage>
            <max_threads>2</max_threads>
            <max_bytes_before_external_group_by>134217728</max_bytes_before_external_group_by>
            <max_bytes_before_external_sort>134217728</max_bytes_before_external_sort>
            <!-- The sampling query profiler only fed system.trace_log (removed in low-memory.xml). -->
            <query_profiler_real_time_period_ns>0</query_profiler_real_time_period_ns>
            <query_profiler_cpu_time_period_ns>0</query_profiler_cpu_time_period_ns>
            <log_queries>0</log_queries>
        </default>
    </profiles>
</clickhouse>
