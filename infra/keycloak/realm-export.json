{
  "realm": "ai-circus",
  "enabled": true,
  "organizationsEnabled": true,
  "sslRequired": "none",
  "bruteForceProtected": true,
  "clientScopes": [
    {
      "name": "organization",
      "description": "Adds the caller's Organization membership to the token — built into Keycloak 26 by default; declared explicitly here so `--import-realm` doesn't depend on that default surviving future versions.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "organization",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-organization-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "organization",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "addOrganizationId": "true",
            "jsonType.label": "JSON",
            "multivalued": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "platform-backend",
      "description": "Carries the `aud` claim ai_circus_shared.auth validates (KEYCLOAK_AUDIENCE) — Keycloak omits `aud` by default, unlike Logto's API resource indicator.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "platform-backend-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "https://api.ai-circus-framework.local",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "basic",
      "description": "The `sub` and `auth_time` claims. Keycloak creates this scope only for realms it builds itself; a realm imported with its own clientScopes must declare it, or access tokens carry no `sub`.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "auth_time",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "consentRequired": false,
          "config": {
            "user.session.note": "AUTH_TIME",
            "claim.name": "auth_time",
            "jsonType.label": "long",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "profile",
      "description": "Name and username claims (standard OIDC scope), declared here for the same reason as `basic`.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "given name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "firstName",
            "claim.name": "given_name",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "family name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "lastName",
            "claim.name": "family_name",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "full name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "email",
      "description": "The `email` and `email_verified` claims (standard OIDC scope), declared here for the same reason as `basic`.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "email",
            "claim.name": "email",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "email verified",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "emailVerified",
            "claim.name": "email_verified",
            "jsonType.label": "boolean",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "roles",
      "description": "Realm roles as `realm_access.roles`, which ai_circus_shared.auth reads (a data product's role, e.g. retail_store_manager), declared here for the same reason as `basic`.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "data-access",
      "description": "Row-filter claims a data product's access policy reads (`access.row_filter.claim`): `stores` for surf_retail's store managers. Values come from the admin-only user attribute of the same name.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "stores",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "stores",
            "claim.name": "stores",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true",
            "multivalued": "true"
          }
        }
      ]
    },
    {
      "name": "mcp-servers",
      "description": "Puts every MCP server client in the user token's audience (T1, docs/adr/0022): a server can only exchange a token it is an audience of. One audience mapper per MCP server.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "crm-mcp audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "crm-mcp",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "crm-api-audience",
      "description": "The only audience crm-mcp may obtain in a token exchange (T2 for crm-api, docs/adr/0022).",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "crm-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "crm-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "ui-react",
      "name": "ui-react",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "redirectUris": [
        "http://aiopen.localhost/*",
        "http://aiopen.localhost/callback",
        "http://localhost:5173/*",
        "http://localhost:5173/callback"
      ],
      "webOrigins": [
        "http://aiopen.localhost",
        "http://localhost:5173"
      ],
      "defaultClientScopes": [
        "basic",
        "organization",
        "platform-backend",
        "profile",
        "email",
        "roles",
        "data-access"
      ],
      "optionalClientScopes": [
        "offline_access"
      ]
    },
    {
      "clientId": "open-webui",
      "name": "Chat UI (Open WebUI)",
      "description": "The optional chat UI (k8s/chat-ui). Confidential: its secret is CHAT_UI_OIDC_CLIENT_SECRET, set by scripts/chat_ui_identity.py, never in this file.",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://chat.localhost/*",
        "access.token.lifespan": "900"
      },
      "redirectUris": [
        "http://chat.localhost/oauth/oidc/callback"
      ],
      "webOrigins": [
        "http://chat.localhost"
      ],
      "defaultClientScopes": [
        "basic",
        "organization",
        "platform-backend",
        "profile",
        "email",
        "roles",
        "data-access",
        "mcp-servers"
      ],
      "optionalClientScopes": [
        "offline_access"
      ]
    },
    {
      "clientId": "crm-mcp",
      "name": "crm-mcp (example MCP server)",
      "description": "Example MCP server built with mcp-kit (docs/adr/0022). Confidential; exchanges a user's token for one valid only at crm-api. Its secret is CRM_MCP_CLIENT_SECRET in .env, never in this file.",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "attributes": {
        "standard.token.exchange.enabled": "true"
      },
      "defaultClientScopes": [
        "basic",
        "organization",
        "roles",
        "data-access",
        "crm-api-audience"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "crm-api",
      "name": "crm-api (example customer API)",
      "description": "Audience of the T2 tokens crm-mcp obtains (docs/adr/0022). Signs no one in and has no secret in use.",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "attributes": {},
      "defaultClientScopes": [],
      "optionalClientScopes": []
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "retail_analyst",
        "description": "surf_retail data product: analyst (its default role)."
      },
      {
        "name": "retail_store_manager",
        "description": "surf_retail data product: store manager, rows filtered by the `stores` claim."
      }
    ]
  }
}
