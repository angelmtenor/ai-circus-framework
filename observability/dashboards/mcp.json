{
  "uid": "ai-circus-mcp",
  "title": "AI Circus · MCP servers — calls, refusals, per-API tokens",
  "description": "MCP servers built with mcp-kit (docs/adr/0022, 0023, 0025): tool calls, policy refusals, per-API token exchanges, the API behind each server, live token checks (level 3) and the audit lines.",
  "tags": [
    "ai-circus"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "annotations": {
    "list": []
  },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "server",
        "label": "MCP server",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(mcp_kit_tool_calls_total, server)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(mcp_kit_tool_calls_total, server)",
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0
      },
      {
        "name": "logs",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Tool calls in range",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "0",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(mcp_kit_tool_calls_total{server=~\"$server\"}[$__range]))",
          "legendFormat": "__auto",
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Calls outside the grant",
      "description": "Tools a caller asked for but the policy does not give it.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "noValue": "0",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(mcp_kit_tool_calls_total{server=~\"$server\",outcome=\"denied\"}[$__range]))",
          "legendFormat": "__auto",
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Refused before MCP (401 + 403)",
      "description": "Missing, forged, expired or foreign tokens (401) and callers with no granted tool (403).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "noValue": "0",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(mcp_kit_access_refused_total{server=~\"$server\"}[$__range]))",
          "legendFormat": "__auto",
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Per-API tokens refused",
      "description": "The identity provider refused a per-API token: misconfiguration, or a server asking beyond its API.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "noValue": "0",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(mcp_kit_token_exchanges_total{server=~\"$server\",outcome=\"refused\"}[$__range]))",
          "legendFormat": "__auto",
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Tool calls per second by tool and outcome",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (server, tool, outcome) (rate(mcp_kit_tool_calls_total{server=~\"$server\"}[5m]))",
          "legendFormat": "{{server}} {{tool}} {{outcome}}",
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Refused before MCP, by reason",
      "description": "A sudden rise means a misconfigured client or someone probing.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (server, reason) (rate(mcp_kit_access_refused_total{server=~\"$server\"}[5m]))",
          "legendFormat": "{{server}} {{reason}}",
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Tool call latency (p50 / p95), API call included",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.50, sum by (le, tool) (rate(mcp_kit_tool_call_duration_seconds_bucket{server=~\"$server\"}[5m])))",
          "legendFormat": "p50 {{tool}}",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, tool) (rate(mcp_kit_tool_call_duration_seconds_bucket{server=~\"$server\"}[5m])))",
          "legendFormat": "p95 {{tool}}",
          "refId": "B",
          "range": true
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Per-API tokens: issued, cached, refused",
      "description": "Cached: the server reused the per-API token it already held for that user token.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (outcome) (rate(mcp_kit_token_exchanges_total{server=~\"$server\"}[5m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "The API behind each server, by status class",
      "description": "4xx is the API's own refusals: another store, another user named in the request.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (server, status_class) (rate(mcp_kit_api_responses_total{server=~\"$server\"}[5m]))",
          "legendFormat": "{{server}} {{status_class}}",
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Token exchange round trip (p95)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, server) (rate(mcp_kit_token_exchange_duration_seconds_bucket{server=~\"$server\"}[5m])))",
          "legendFormat": "{{server}}",
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Live token checks (level 3): active, inactive, unavailable",
      "description": "docs/adr/0025: every request's user token asked at the identity provider. Inactive = a signed-out or revoked session's token used again; unavailable = refused, never waved through.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (server, outcome) (rate(mcp_kit_introspections_total{server=~\"$server\"}[5m]))",
          "legendFormat": "{{server}} {{outcome}}",
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Live token check round trip (p95)",
      "description": "What level 3 adds to each request.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, server) (rate(mcp_kit_introspection_duration_seconds_bucket{server=~\"$server\"}[5m])))",
          "legendFormat": "{{server}}",
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "id": 11,
      "type": "logs",
      "title": "Audit lines: who, which tool, which outcome (never arguments, results or tokens)",
      "description": "One line per decision of the kit. Open a line to jump to its trace.",
      "datasource": {
        "type": "loki",
        "uid": "${logs}"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 24,
        "h": 10
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${logs}"
          },
          "expr": "{service_name=~\"$server\"} | logger=\"mcp_kit.audit\"",
          "refId": "A",
          "queryType": "range"
        }
      ]
    }
  ]
}
