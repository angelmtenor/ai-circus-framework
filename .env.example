# Copy to .env (`make bootstrap`) and fill in secrets. Never commit the real .env.
# Each generated service under services/*/ also has its own .env(.example) for
# service-specific settings.yaml-derived variables — this file only covers the
# platform-wide infra containers and cross-service wiring.

# ── Postgres (backs both Keycloak and the `platform` schema used by platform-registry) ─
POSTGRES_USER=ai_circus
POSTGRES_PASSWORD=change-me
POSTGRES_DB=platform
POSTGRES_PORT=5432

# ── platform-registry (scenario/entitlement registry; not routed through Traefik) ──
# Published to host loopback only, for services running outside Docker (local dev).
PLATFORM_REGISTRY_PORT=8010

# ── Keycloak (identity provider: hosted sign-in, Organizations = tenants, roles) ────
# Keycloak's own server root — internal docker/k8s DNS is http://keycloak:8080 (used
# by every backend service's KEYCLOAK_JWKS_URL below); this *.localhost form is the
# public, browser-facing one (ui-react, and the sync/provision tooling run from your
# host).
KEYCLOAK_SERVER_URL=http://keycloak.localhost
KEYCLOAK_REALM=ai-circus
# Full realm issuer URL — embedded in real tokens, so it must match exactly what
# jwt.decode's issuer check compares against.
KEYCLOAK_ISSUER=http://keycloak.localhost/realms/ai-circus
# NOT read directly by the running API (see KEYCLOAK_JWKS_URL as actually wired in
# docker-compose.yml/k8s: it's hardcoded to the internal-DNS form, same reasoning as
# Logto's JWKS URL previously needed) — this is the public form, useful for manual
# checks against the realm from your host.
KEYCLOAK_JWKS_URL=http://keycloak.localhost/realms/ai-circus/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=https://api.ai-circus-framework.local
# Service-account client used by platform-registry's sync tooling (Phase 4) — created
# via the realm bootstrap (infra/keycloak/realm-export.json) or the Admin Console;
# needs manage-users/manage-organizations/manage-realm/manage-clients realm-management
# roles, granted once via KEYCLOAK_ADMIN_USERNAME/KEYCLOAK_ADMIN_PASSWORD below (no
# Logto analog — Logto's M2M app didn't need a separate privilege-grant step).
KEYCLOAK_M2M_CLIENT_ID=
KEYCLOAK_M2M_CLIENT_SECRET=
# Only used by the provision-owner tooling (services/platform-registry) — creates/finds
# a real Keycloak Organization + user with this email, entitled to every scenario.
KEYCLOAK_OWNER_EMAIL=angelmtenor@gmail.com
KEYCLOAK_OWNER_PASSWORD=
# The container's OWN bootstrap admin (Keycloak's KC_BOOTSTRAP_ADMIN_USERNAME/
# KC_BOOTSTRAP_ADMIN_PASSWORD) — distinct from KEYCLOAK_OWNER_* above, which is a
# realm user. Used once to grant the M2M service account its realm-management roles;
# also gates the Basic-Auth-protected admin.keycloak.localhost Admin Console route.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# ── Qdrant (vector store for conversational_rag scenarios) ─────────────────────────
# QDRANT_HTTP_PORT is published to host loopback only (not Traefik — Qdrant has no
# auth of its own, so it must never sit on the public entrypoint), for rag-agent/
# etl-vectorize running outside Docker to still reach it.
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# ── Embeddings (etl-vectorize + rag-agent — MUST be set the same for both, or
# retrieval silently breaks: they embed into/out of the same Qdrant vector space).
# "local" (default) runs voyage-4-nano via sentence-transformers, no API key, no
# per-token cost. "gemini" reuses GOOGLE_API_KEY below (llm-gateway section).
# "voyage" needs VOYAGE_API_KEY here.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=
VOYAGE_API_KEY=

# ── SeaweedFS (S3-compatible object storage for datasets/models/documents) ─────────
OBJECT_STORE_ACCESS_KEY=ai_circus
OBJECT_STORE_SECRET_KEY=change-me-8-chars-minimum

# ── Traefik (single ingress point; everything else is reached through it) ──────────
TRAEFIK_HTTP_PORT=80
TRAEFIK_DASHBOARD_PORT=8080

# ── llm-gateway (LiteLLM proxy — model routing; you need AT LEAST ONE of the keys
# below set, OR run `make ollama-up` to use the optional local Ollama fallback) ────
# Published to host loopback only (not routed through Traefik — see docker-compose.yml):
# no caller reaches it directly except assistant/rag-agent/platform-registry over the
# internal docker network, and this port is only for services running outside Docker.
LLM_GATEWAY_PORT=4000
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_BASE=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Only needed if you run `make ollama-up` (starts the optional `ollama` container,
# docker-compose.yml — off by default to save RAM/disk) or point at an Ollama
# instance you run yourself; llm-gateway's "llama3" model uses this as its base URL.
OLLAMA_API_BASE=
LITELLM_MASTER_KEY=change-me

# assistant/rag-agent's model — defaults to "groq-llama" (GroqCloud free tier, see
# GROQ_API_KEY above). Switch to gpt-4o-mini/gemini-flash/deepseek-chat/llama3
# (local Ollama, needs `make ollama-up`)/openrouter/claude-haiku/azure-gpt4o once
# you've set that provider's key above (check what's actually working via
# ui-react's admin Settings page → Test).
LLM_MODEL=

# ── Voice mode (agui-voice — mic input + speaker-icon TTS in ui-react's chat panel).
# Defaults are self-hosted/no-API-key (faster-whisper STT, Piper TTS). Set
# VOICE_STT_PROVIDER=deepgram / VOICE_TTS_PROVIDER=elevenlabs|cartesia plus the
# matching key below to swap in a cloud provider (also needs
# `uv add "pipecat-ai[deepgram]"` etc. inside services/agui-voice first — see its
# settings.yaml).
VOICE_STT_PROVIDER=whisper
VOICE_TTS_PROVIDER=piper
VOICE_WHISPER_MODEL=base
VOICE_PIPER_VOICE_ID=en_US-lessac-medium
VOICE_PIPER_VOICE_ID_ES=es_ES-davefx-medium
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# ── Public deployment (any public VM, minikube behind a public Ingress, ...) —
# "local" (default) or "public"; deploy is still `make up` either
# way, just with this (and the credentials below) set first. Not the same thing as
# APP_ENVIRONMENT elsewhere in this repo, which only ever picks a service's own
# settings.yaml profile and is "docker" for both local `docker compose up` dev and a
# real deployment identically — it can't tell the two apart. DEPLOYMENT_TARGET=public
# makes every service refuse to boot (rather than silently accept it) if
# ADMIN_API_KEY/ENGINEERING_DEMO_API_KEY are still their shipped demo values below, or
# AUTH_DISABLED=true — see libs/shared/src/ai_circus_shared/deployment_guard.py and
# `make check-public-ready`.
DEPLOYMENT_TARGET=local

# ── Admin credential — a bearer token resolving to the "admin" org, auto-granted
# access to every scenario platform-registry seeds (see ai_circus_shared.auth). This
# default value is intentionally a mildly-public demo credential, not a real secret —
# rotate it, or leave it blank to disable the shortcut outright (falls through to
# real Keycloak auth, see ai_circus_shared.auth.resolve_caller_identity), before any
# deployment beyond local development. PUBLIC_DEPLOYMENT=true enforces this at boot.
ADMIN_API_KEY=ai-circus-2026

# ── Optional second demo credential — a bearer token resolving to the narrower
# "engineering-demo" org, auto-granted access to only the mpm/electric_motor/
# energy_building scenarios (see ai_circus_shared.auth + platform-registry's
# ENGINEERING_DEMO_SCENARIOS). Same "mildly-public demo credential" caveat as
# ADMIN_API_KEY above. Leave blank to disable this login option entirely.
ENGINEERING_DEMO_API_KEY=ai-circus-engineering-2026

# ── Comma-separated origins ui-react is allowed to call platform-registry/prediction/
# assistant/rag-agent from. Defaults to the local Traefik hostname + Vite dev server;
# override with your real frontend origin(s) beyond local development.
CORS_ALLOWED_ORIGINS=http://aiopen.localhost,http://localhost:5173

# ── Dev-only auth bypass — secure (false) by default, matching every backend
# service's own AUTH_DISABLED default. Flip BOTH to "true" together to iterate
# locally before Keycloak is configured (see README's identity-provider setup
# section); never set either to "true" beyond local development.
AUTH_DISABLED=false
DEV_MODE=false

# ui-react is a public SPA client (PKCE, no client secret) — declared directly in
# infra/keycloak/realm-export.json's declarative bootstrap (clientId "ui-react"), not
# hand-created via a console like Logto's application required. VITE_KEYCLOAK_CLIENT_ID
# only needs overriding here if you rename that client.
VITE_KEYCLOAK_ISSUER=http://keycloak.localhost/realms/ai-circus
VITE_KEYCLOAK_CLIENT_ID=ui-react
VITE_KEYCLOAK_AUDIENCE=https://api.ai-circus-framework.local

# ── ui-react's other backend URLs are baked in at BUILD time (see ui-react/src/
# config.ts), not read from this .env file — they default to this demo's Traefik
# hostnames (http://prediction.localhost, etc.) and platform-registry's loopback
# port, which is correct for `docker compose up` as shipped. To point a built
# ui-react bundle at different URLs (e.g. a real domain), set VITE_PLATFORM_REGISTRY_URL/
# VITE_PREDICTION_URL/VITE_ASSISTANT_URL/VITE_RAG_AGENT_URL as build args
# (docker-compose.yml's ui-react service currently only passes VITE_KEYCLOAK_ISSUER/
# VITE_KEYCLOAK_CLIENT_ID/VITE_KEYCLOAK_AUDIENCE/VITE_DEV_MODE/VITE_DEV_ORG_ID —
# add the rest there too if you need to override them for a real deployment).
