# Copy to .env (`make bootstrap`) and fill in secrets. Never commit the real .env.
# Each generated service under services/*/ also has its own .env(.example) for
# service-specific settings.yaml-derived variables — this file only covers the
# platform-wide infra containers and cross-service wiring.

# ── Postgres (backs both Logto and the `platform` schema used by platform-registry) ─
POSTGRES_USER=ai_circus
POSTGRES_PASSWORD=change-me
POSTGRES_DB=platform
POSTGRES_PORT=5432

# ── platform-registry (scenario/entitlement registry; not routed through Traefik) ──
# Published to host loopback only, for services running outside Docker (local dev).
PLATFORM_REGISTRY_PORT=8010

# ── Logto (identity provider: hosted sign-in, Organizations = tenants, roles) ───────
LOGTO_PORT=3001
LOGTO_ADMIN_PORT=3002
# 32+ char random string, e.g. `openssl rand -hex 32`
LOGTO_ENDPOINT_COOKIE_SECRET=change-me-32-chars-minimum
LOGTO_TRUST_PROXY_HEADER=1
# Filled in after configuring Logto's console (API resource + M2M app for platform-registry)
LOGTO_ISSUER=http://logto.localhost/oidc
LOGTO_M2M_APP_ID=
LOGTO_M2M_APP_SECRET=
LOGTO_API_RESOURCE_INDICATOR=https://api.ai-circus-framework.local

# ── Qdrant (vector store for conversational_rag scenarios) ─────────────────────────
# QDRANT_HTTP_PORT is published to host loopback only (not Traefik — Qdrant has no
# auth of its own, so it must never sit on the public entrypoint), for rag-agent/
# etl-vectorize running outside Docker to still reach it.
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# ── MinIO (S3-compatible object storage for datasets/models/documents) ─────────────
MINIO_ROOT_USER=ai_circus
MINIO_ROOT_PASSWORD=change-me-8-chars-minimum
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── Traefik (single ingress point; everything else is reached through it) ──────────
TRAEFIK_HTTP_PORT=80
TRAEFIK_DASHBOARD_PORT=8080

# ── llm-gateway (LiteLLM proxy — model routing; you need AT LEAST ONE of the keys
# below set, OR run `make ollama-up` to use the optional local Ollama fallback) ────
# Published to host loopback only (not routed through Traefik — see docker-compose.yml):
# no caller reaches it directly except assistant/rag-agent/platform-registry over the
# internal docker network, and this port is only for services running outside Docker.
LLM_GATEWAY_PORT=4000
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_BASE=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Only needed if you run `make ollama-up` (starts the optional `ollama` container,
# docker-compose.yml — off by default to save RAM/disk) or point at an Ollama
# instance you run yourself; llm-gateway's "llama3" model uses this as its base URL.
OLLAMA_API_BASE=
LITELLM_MASTER_KEY=change-me

# assistant/rag-agent's model — defaults to "llama3" (local Ollama, see above; only
# answers once `make ollama-up` has been run). Switch to gpt-4o-mini/gemini-flash/
# deepseek-chat/groq-llama/openrouter/claude-haiku/azure-gpt4o once you've set that provider's key
# above (check what's actually working via ui-react's admin Settings page → Test).
LLM_MODEL=

# ── Admin credential — a bearer token resolving to the "admin" org, auto-granted
# access to every scenario platform-registry seeds (see ai_circus_shared.auth). This
# default value is intentionally a mildly-public demo credential, not a real secret —
# rotate it (and keep it out of version control via your own .env) before any
# deployment beyond local development.
ADMIN_API_KEY=ai-circus-2026

# ── Optional second demo credential — a bearer token resolving to the narrower
# "engineering-demo" org, auto-granted access to only the mpm/electric_motor/
# energy_building scenarios (see ai_circus_shared.auth + platform-registry's
# ENGINEERING_DEMO_SCENARIOS). Same "mildly-public demo credential" caveat as
# ADMIN_API_KEY above. Leave blank to disable this login option entirely.
ENGINEERING_DEMO_API_KEY=ai-circus-engineering-2026

# ── Comma-separated origins ui-react is allowed to call platform-registry/prediction/
# assistant/rag-agent from. Defaults to the local Traefik hostname + Vite dev server;
# override with your real frontend origin(s) beyond local development.
CORS_ALLOWED_ORIGINS=http://react.localhost,http://localhost:5173

# ── Dev-only auth bypass — secure (false) by default, matching every backend
# service's own AUTH_DISABLED default. Flip BOTH to "true" together to iterate
# locally before Logto is configured (see README "First-time Logto setup"); never
# set either to "true" beyond local development.
AUTH_DISABLED=false
DEV_MODE=false

# ui-react is a public SPA client (PKCE, no client secret) — register a Logto
# application for it (Application type: Single Page App).
UI_REACT_LOGTO_APP_ID=

# ── ui-react's other backend URLs are baked in at BUILD time (see ui-react/src/
# config.ts), not read from this .env file — they default to this demo's Traefik
# hostnames (http://prediction.localhost, etc.) and platform-registry's loopback
# port, which is correct for `docker compose up` as shipped. To point a built
# ui-react bundle at different URLs (e.g. a real domain), set VITE_PLATFORM_REGISTRY_URL/
# VITE_PREDICTION_URL/VITE_ASSISTANT_URL/VITE_RAG_AGENT_URL/VITE_LOGTO_ENDPOINT/
# VITE_LOGTO_API_RESOURCE_INDICATOR as build args (docker-compose.yml's ui-react
# service currently only passes VITE_LOGTO_APP_ID/VITE_DEV_MODE/VITE_DEV_ORG_ID —
# add the rest there too if you need to override them for a real deployment).
