# Active Environment Profile (local, docker, staging, production)
APP_ENVIRONMENT=local

# API key for Deepgram STT, required only when STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=

# API key for ElevenLabs TTS, required only when TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=

# API key for Cartesia TTS, required only when TTS_PROVIDER=cartesia
CARTESIA_API_KEY=

# Shared admin bearer token — resolves to the 'admin' org, entitled to every scenario
ADMIN_API_KEY=

# Optional demo bearer token for 'engineering-demo' org (mpm/electric_motor/energy_building only)
ENGINEERING_DEMO_API_KEY=
