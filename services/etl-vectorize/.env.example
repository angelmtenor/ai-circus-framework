# Active Environment Profile (local, docker, staging, production)
APP_ENVIRONMENT=local

# MinIO secret key (must match MINIO_ROOT_PASSWORD in the repo root .env)
MINIO_SECRET_KEY=

# Google API key (only needed if EMBEDDING_PROVIDER=gemini)
GOOGLE_API_KEY=

# Voyage AI API key (only needed if EMBEDDING_PROVIDER=voyage)
VOYAGE_API_KEY=
