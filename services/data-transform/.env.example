# Active Environment Profile (local, docker, staging, production)
APP_ENVIRONMENT=local

# Postgres password
POSTGRES_PASSWORD=

# HMAC key pseudonymising personal identifiers in silver (kept in a private table, never in SQL)
DATA_PSEUDONYM_KEY=

# ClickHouse password (analytics tier only)
CLICKHOUSE_PASSWORD=

# SeaweedFS secret key (must match OBJECT_STORE_SECRET_KEY in the repo root .env)
OBJECT_STORE_SECRET_KEY=

# Superset admin password (bi tier: the bi-sync Job)
SUPERSET_ADMIN_PASSWORD=
