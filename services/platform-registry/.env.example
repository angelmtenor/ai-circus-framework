# Active Environment Profile (local, docker, staging, production)
APP_ENVIRONMENT=local

# Postgres password
POSTGRES_PASSWORD=

# Service-account client secret for calling Keycloak's Admin REST API (sync/provision tooling only)
KEYCLOAK_M2M_CLIENT_SECRET=

# Password for the real Keycloak user the provision-owner tool creates (provision tool only)
KEYCLOAK_OWNER_PASSWORD=

# Bearer token required on /llm-settings/* (shared with other services' admin-key bypass)
ADMIN_API_KEY=

# Optional shared demo bearer token, checked by GET /auth/verify-engineering-demo-key
ENGINEERING_DEMO_API_KEY=

# API key presented to llm-gateway (its LITELLM_MASTER_KEY) for admin calls
LLM_GATEWAY_API_KEY=
