# Active Environment Profile (local, docker, staging, production)
APP_ENVIRONMENT=local

# Postgres password
POSTGRES_PASSWORD=

# Machine-to-machine application secret for calling Logto's Management API (sync tool only)
LOGTO_M2M_APP_SECRET=

# Bearer token required on /llm-settings/* (shared with other services' admin-key bypass)
ADMIN_API_KEY=

# Optional shared demo bearer token — checked (not enforced) by GET /auth/verify-engineering-demo-key, which the login screen's engineering-demo login uses to fail fast on a bad key
ENGINEERING_DEMO_API_KEY=

# API key presented to llm-gateway (its LITELLM_MASTER_KEY) for admin calls
LLM_GATEWAY_API_KEY=
