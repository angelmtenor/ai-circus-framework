# Active Environment Profile (local, docker, staging, production)
APP_ENVIRONMENT=local

# MinIO secret key (must match MINIO_ROOT_PASSWORD in the repo root .env)
MINIO_SECRET_KEY=

# Shared admin bearer token — resolves to the 'admin' org, entitled to every scenario
ADMIN_API_KEY=

# Optional shared demo bearer token — resolves to the 'engineering-demo' org, entitled to only mpm/electric_motor/energy_building
ENGINEERING_DEMO_API_KEY=
