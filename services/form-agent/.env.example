# Active Environment Profile (local, docker, staging, production)
APP_ENVIRONMENT=local

# Postgres password
POSTGRES_PASSWORD=

# SeaweedFS secret key (must match OBJECT_STORE_SECRET_KEY in the repo root .env)
OBJECT_STORE_SECRET_KEY=

# API key presented to llm-gateway (its LITELLM_MASTER_KEY)
LLM_GATEWAY_API_KEY=

# Shared admin bearer token — resolves to the 'admin' org, entitled to every scenario
ADMIN_API_KEY=

# Optional demo bearer token for 'engineering-demo' org (mpm/electric_motor/energy_building)
ENGINEERING_DEMO_API_KEY=

# Google API key (only needed if EMBEDDING_PROVIDER=gemini)
GOOGLE_API_KEY=

# Voyage AI API key (only needed if EMBEDDING_PROVIDER=voyage)
VOYAGE_API_KEY=
