# Active Environment Profile (local, docker, staging, production)
APP_ENVIRONMENT=local

# Master API key callers must present to the gateway (Bearer token)
LITELLM_MASTER_KEY=

# OpenAI API key (only needed if litellm_config.yaml routes to an openai/* model)
OPENAI_API_KEY=

# Google API key (only needed if litellm_config.yaml routes to a gemini/* model)
GOOGLE_API_KEY=

# Azure OpenAI API key (only needed if litellm_config.yaml routes to an azure/* model)
AZURE_OPENAI_API_KEY=

# DeepSeek API key (only needed if litellm_config.yaml routes to the deepseek-chat model)
DEEPSEEK_API_KEY=

# GroqCloud API key (only needed if litellm_config.yaml routes to the groq-llama model)
GROQ_API_KEY=

# OpenRouter API key (only needed if litellm_config.yaml routes to the openrouter model)
OPENROUTER_API_KEY=

# Anthropic API key (only needed if litellm_config.yaml routes to the claude-haiku model)
ANTHROPIC_API_KEY=
