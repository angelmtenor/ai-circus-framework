# Active Environment Profile (local, docker, staging, production)
APP_ENVIRONMENT=local

# Master API key callers must present to the gateway (Bearer token)
LITELLM_MASTER_KEY=

# OpenAI API key (only needed if litellm_config.yaml routes to an openai/* model)
OPENAI_API_KEY=

# Google API key (only needed if litellm_config.yaml routes to a gemini/* model)
GOOGLE_API_KEY=

# Azure OpenAI API key (only needed if litellm_config.yaml routes to an azure/* model)
AZURE_OPENAI_API_KEY=
