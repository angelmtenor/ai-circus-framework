{
  "files.autoSave": "afterDelay",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "editor.formatOnSave": true,
  "editor.rulers": [
    120
  ],
  "editor.insertSpaces": true,
  "editor.tabSize": 4,
  "editor.detectIndentation": false,
  "[python]": {
    "editor.formatOnSave": true,
    "editor.insertSpaces": true,
    "editor.tabSize": 4,
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  "python.languageServer": "Pylance",
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "cSpell.language": "en",
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": [
    "tests"
  ],
  "python.testing.unittestEnabled": false,
  "cSpell.words": [
    "addopts",
    "classmethod",
    "cookiecutter",
    "debugpy",
    "deptry",
    "docstrings",
    "dotenv",
    "fastapi",
    "gitleaks",
    "httpx",
    "isort",
    "loguru",
    "maxfail",
    "mccabe",
    "minversion",
    "mypy",
    "noqa",
    "nvidia",
    "pathlib",
    "psutil",
    "pycache",
    "pycodestyle",
    "pydantic",
    "pydocstyle",
    "pyflakes",
    "pygrep",
    "pyinstrument",
    "pyproject",
    "pyrefly",
    "pyright",
    "pytest",
    "pyupgrade",
    "refurb",
    "repr",
    "ruff",
    "setuptools",
    "styleguide",
    "testpaths",
    "tput",
    "tzdata",
    "unicode",
    "uvicorn",
    "venv",
    "virtualenv",
    "zoneinfo"
  ]
}
