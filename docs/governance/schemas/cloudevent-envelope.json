      "title": "Specversion",
      "type": "string"
    },
    "subject": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Subject"
    },
    "tenantid": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tenantid"
    },
    "time": {
      "title": "Time",
      "type": "string"
    },
    "type": {
      "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+\\.governance\\.[a-z_]+(\\.[a-z_]+)*\\.v[0-9]+$",
