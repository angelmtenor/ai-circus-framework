# Root orchestration for ai-circus-framework. Each service under services/ and each
# UI has its own Makefile (generated by ai-circus-template) for `make check`/`make run`
# from inside that service's directory — this Makefile only orchestrates across them.

.DEFAULT_GOAL := help

ifneq (,$(wildcard .env))
    include .env
    export
endif

CYAN  := $(shell tput setaf 6 2>/dev/null)
RESET := $(shell tput sgr0 2>/dev/null)

.PHONY: help bootstrap up up-infra generate-console-auth check-public-ready down logs pipeline new-service \
	sync-shared check-all clean ollama-up k3s-vllm-up k3s-vllm-down k3s-chat-ui-up k3s-chat-ui-down k3s-librechat-up k3s-librechat-down k3s-mcp-lite k3s-mcp-lite-verify k3s-mcp-lite-down k3s-mcp-pseudonym k3s-mcp-examples-up k3s-mcp-examples-down mcp-catalog mcp-catalog-check mcp-catalog-portal k3s-mcp-catalog-apply mcp-tls k3s-mcp-tls all reset-all wait-infra wait-services verify \
	data-platform-up data-platform-down \
	k3s-cluster k3s-build k3s-import k3s-secrets k3s-up k3s-wait k3s-pipeline k3s-vectorize k3s-verify k3s-idle-check k3s-embed-onnx k3s-down \
	k3s-gpu-telemetry k3s-all k3s-all-lite k3s-pause k3s-resume k3s-lite k3s-full k3s-resume-lite k3s-demo k3s-demo-off k3s-clickhouse-drop-system-logs k3s-portforward k3s-portforward-stop k3s-portforward-uninstall k3s-mcp-portforward k3s-mcp-portforward-uninstall \
	k3s-data-platform-up k3s-data-platform-down k3s-data-build k3s-data-core-up k3s-data-core-down k3s-data-seed k3s-data-seed-lite k3s-data-ml k3s-data-call k3s-data-transform k3s-data-reset k3s-ui-image k3s-data-analytics-up k3s-data-analytics-down k3s-data-bi-up k3s-data-bi-sync k3s-data-bi-down k3s-data-governance-up k3s-data-catalog-sync k3s-data-governance-down k3s-governance-opa-up k3s-governance-opa-down k3s-governance-opa-test k3s-data-showcase k3s-data-showcase-off k3s-data-demo k3s-data-demo-off \
	dl-gpu-check dl-data dl-artifacts-export dl-artifacts-import dl-train dl-train-nlp dl-train-cv dl-train-anomaly text-embeddings k3s-text-embeddings \
	k3s-dl-build k3s-dl-up k3s-dl-down k3s-dl-train k3s-dl-train-nlp k3s-dl-train-cv k3s-dl-train-anomaly k3s-all-dl k3s-gpu-smoke \
	k3s-obs-up k3s-obs-down k3s-obs-restart

help: ## Show this help message
	@grep -hE '^[a-zA-Z0-9_-]+:.*?## .*$$' $(MAKEFILE_LIST) | sort | \
		awk 'BEGIN {FS=":.*?## "}; {printf "  $(CYAN)%-18s$(RESET) %s\n", $$1, $$2}'

# ── Bootstrap ─────────────────────────────────────────────────────────────────

bootstrap: ## Create .env from .env.example, console.htpasswd from its .example (if missing), and infra/seaweedfs/s3.json from .env
	@if [ ! -f .env ] && [ -f .env.example ]; then echo "📝 Creating .env from .env.example..."; cp .env.example .env; fi
	@if [ ! -f infra/traefik/console.htpasswd ] && [ -f infra/traefik/console.htpasswd.example ]; then \
		echo "📝 Creating infra/traefik/console.htpasswd from its .example (demo credential — rotate with 'make generate-console-auth' before a public deployment)..."; \
		cp infra/traefik/console.htpasswd.example infra/traefik/console.htpasswd; \
	fi
	@./scripts/generate_seaweedfs_s3_config.sh
	@echo "✓ Edit .env (Keycloak/LLM/SeaweedFS secrets) before running 'make up'"

# ── Compose lifecycle ─────────────────────────────────────────────────────────

up-infra: ## Start only the platform infra (postgres, keycloak, qdrant, seaweedfs, valkey, traefik)
	@docker compose up -d postgres keycloak qdrant seaweedfs valkey traefik

up: ## Start the full platform (infra + all backend services + the UI)
	@mkdir -p demo/themes
	@docker compose up -d --build

down: ## Stop and remove all containers
	@docker compose down

logs: ## Tail logs for all running containers
	@docker compose logs -f --tail=200

pipeline: ## Run the one-shot ETL -> training pipeline (every tabular_ml scenario in SCENARIOS, empty/unset = all), then (re)start prediction
	@docker compose up --build etl-tabular
	@docker compose up --build training
	@docker compose up -d --build prediction

data-platform-up: ## Start the optional Data Platform profile (currently: Kafka event streaming) — off by default, ~768MB RAM
	@docker compose --profile data-platform up -d --build kafka
	@echo "✓ kafka up — data-platform-manager will start publishing/reading real events against it"

data-platform-down: ## Stop the optional Data Platform profile's containers (state is kept — see docker-compose.yml's kafka-data volume)
	@docker compose --profile data-platform stop kafka

ollama-up: ## Start the optional bundled Ollama (free, no-API-key LLM fallback; pulls llama3.2:3b, ~2GB, on first run)
	@docker compose --profile ollama up -d ollama ollama-pull

# ── Public deployment (any public VM, or minikube behind a public Ingress) — no
# separate compose file or `up` variant: `make up` already serves both
# local dev and a real deployment, differentiated purely by .env (same as
# ADMIN_API_KEY/OBJECT_STORE_SECRET_KEY/etc. always have been). See README "Public
# deployment" for the full checklist; the two commands below cover the parts that
# are easy to forget.

generate-console-auth: ## (Re)generate infra/traefik/console.htpasswd — the Basic Auth credential gating admin.keycloak/console.objectstore/mlflow — usage: make generate-console-auth [CONSOLE_USER=admin] [CONSOLE_PASSWORD=...] (omit the password for a random one)
	@./scripts/generate_console_auth.sh "$(CONSOLE_USER)" "$(CONSOLE_PASSWORD)"

check-public-ready: ## Verify .env/console.htpasswd don't still hold shipped demo values before a public deployment (does not start/stop anything)
	@ok=1; \
	if [ "$${DEPLOYMENT_TARGET:-local}" != "public" ]; then \
		echo "❌ DEPLOYMENT_TARGET is not 'public' in .env — every service's boot-time guard is a no-op until it is"; ok=0; \
	fi; \
	if [ "$${ADMIN_API_KEY:-angel2026}" = "angel2026" ]; then \
		echo "❌ ADMIN_API_KEY is still the shipped demo default — rotate it or blank it in .env"; ok=0; \
	fi; \
	if [ "$${ENGINEERING_DEMO_API_KEY:-}" = "ai-circus-engineering-2026" ]; then \
		echo "❌ ENGINEERING_DEMO_API_KEY is still the shipped demo default — rotate it or blank it in .env"; ok=0; \
	fi; \
	if [ "$${AUTH_DISABLED:-false}" = "true" ]; then \
		echo "❌ AUTH_DISABLED=true in .env — this bypasses Keycloak entirely, never set it for a public deployment"; ok=0; \
	fi; \
	if [ ! -f infra/traefik/console.htpasswd ]; then \
		echo "❌ infra/traefik/console.htpasswd is missing — run 'make generate-console-auth'"; ok=0; \
	elif [ -f infra/traefik/console.htpasswd.example ] && cmp -s infra/traefik/console.htpasswd infra/traefik/console.htpasswd.example; then \
		echo "❌ infra/traefik/console.htpasswd still holds the shipped demo credential — run 'make generate-console-auth'"; ok=0; \
	fi; \
	if [ -f infra/seaweedfs/s3.json.example ] && cmp -s infra/seaweedfs/s3.json infra/seaweedfs/s3.json.example 2>/dev/null; then \
		echo "❌ infra/seaweedfs/s3.json still holds the shipped demo credential — set OBJECT_STORE_ACCESS_KEY/SECRET_KEY in .env then run './scripts/generate_seaweedfs_s3_config.sh'"; ok=0; \
	fi; \
	if [ "$$ok" = "1" ]; then echo "✓ looks ready for a public deployment — run 'make up' (or 'make all') on the target host"; else exit 1; fi

# ── One-shot setup / troubleshooting ────────────────────────────────────────────
#
# `all` exists because the individual steps above have a real ordering dependency
# (`up` before `pipeline`, both after `up-infra`'s containers are actually healthy —
# not just "started") that's easy to get wrong on a fresh clone, especially on a
# machine other than the one the repo was first set up on. `verify` reproduces the
# exact request the browser's login screen makes, so a "Failed to fetch" in the UI
# can be diagnosed here, with logs, before it's ever a browser mystery.

all: ## One-shot: bootstrap .env, start infra+services, run both pipelines, verify the admin tenant end-to-end (safe to re-run any time; use this instead of the individual up-infra/up/pipeline steps unless you need finer control)
	@$(MAKE) bootstrap
	@$(MAKE) up-infra
	@$(MAKE) wait-infra
	@$(MAKE) up
	@$(MAKE) wait-services
	@$(MAKE) pipeline
	@echo "▶ vectorizing the conversational_rag scenario's reference docs..."
	@docker compose up --build etl-vectorize
	@$(MAKE) verify
	@echo ""
	@echo "🎉 ai-circus-framework is up — open http://aiopen.localhost, pick 'admin' from the User dropdown, and use the ADMIN_API_KEY from .env as the password."
	@if [ -z "$$OPENAI_API_KEY$$GOOGLE_API_KEY$$AZURE_OPENAI_API_KEY$$DEEPSEEK_API_KEY$$GROQ_API_KEY$$OPENROUTER_API_KEY$$ANTHROPIC_API_KEY" ]; then \
		echo "ℹ️  No LLM provider key set in .env — chat (assistant/rag-agent) won't answer yet."; \
		echo "   Add one provider key to .env then 'make up', or run 'make ollama-up' for a free local fallback."; \
	fi

reset-all: ## Nuke containers + volumes + per-service build artifacts, then rebuild fresh via `make all` — the fastest way back to a known-good state, and what to run before sharing this repo so it's proven from a clean slate
	@echo "🧹 tearing down containers + volumes (postgres/keycloak/qdrant/seaweedfs data all reset)..."
	@docker compose down -v
	@$(MAKE) all

wait-infra: ## Wait for postgres+keycloak to report healthy (internal step of `make all`; also handy standalone if `make up-infra` seems stuck)
	@echo "⏳ waiting for postgres..."
	@i=0; until [ "$$(docker compose ps postgres --format '{{.Health}}' 2>/dev/null)" = "healthy" ]; do \
		i=$$((i+1)); [ $$i -ge 60 ] && { echo "❌ postgres never became healthy — check: docker compose logs postgres"; exit 1; }; \
		sleep 2; \
	done
	@echo "⏳ waiting for keycloak (first boot imports the realm — can take a couple of minutes)..."
	@i=0; until [ "$$(docker compose ps keycloak --format '{{.Health}}' 2>/dev/null)" = "healthy" ]; do \
		i=$$((i+1)); [ $$i -ge 90 ] && { echo "❌ keycloak never became healthy — check: docker compose logs keycloak"; exit 1; }; \
		sleep 2; \
	done
	@echo "✓ infra healthy"

wait-services: ## Wait for platform-registry and every Traefik-routed backend to answer real requests (internal step of `make all`)
	@echo "⏳ waiting for platform-registry..."
	@i=0; until curl -sf "http://localhost:$${PLATFORM_REGISTRY_PORT:-8010}/healthz" >/dev/null 2>&1; do \
		i=$$((i+1)); [ $$i -ge 60 ] && { echo "❌ platform-registry never came up — check: docker compose logs platform-registry"; exit 1; }; \
		sleep 2; \
	done
	@for host in prediction assistant rag-agent; do \
		echo "⏳ waiting for $$host.localhost (via Traefik)..."; \
		i=0; until curl -sf "http://$$host.localhost/healthz" >/dev/null 2>&1; do \
			i=$$((i+1)); \
			[ $$i -ge 60 ] && { echo "❌ $$host.localhost never answered — check: docker compose logs $$host, and that 'getent hosts $$host.localhost' resolves to 127.0.0.1"; exit 1; }; \
			sleep 2; \
		done; \
	done
	@echo "⏳ waiting for aiopen.localhost..."
	@i=0; until curl -sf "http://aiopen.localhost/" >/dev/null 2>&1; do \
		i=$$((i+1)); [ $$i -ge 60 ] && { echo "❌ aiopen.localhost never answered — check: docker compose logs ui-react, and that port 80 isn't already used by something else on this machine"; exit 1; }; \
		sleep 2; \
	done
	@echo "⏳ waiting for langfuse.localhost (first boot migrates Postgres + ClickHouse — a few minutes on a laptop)..."
	@i=0; until curl -sf "http://langfuse.localhost/api/public/health" >/dev/null 2>&1; do \
		i=$$((i+1)); [ $$i -ge 150 ] && { echo "❌ langfuse.localhost never answered — check: docker compose logs langfuse-web clickhouse"; exit 1; }; \
		sleep 2; \
	done
	@echo "✓ all services answering"

# Monitors `verify` may skip because they were scaled down on purpose (`k3s-lite`/`k3s-demo`): langfuse and/or mlflow.
VERIFY_SKIP ?=

verify: ## Curl-check the admin (and, if configured, engineering-demo) tenant end-to-end — the exact calls the login screen makes — catches "Failed to fetch"-class setup issues before you open a browser — VERIFY_SKIP="langfuse mlflow" skips the monitors
	@echo "🔎 verifying admin tenant end-to-end..."
	@key="$${ADMIN_API_KEY:-angel2026}"; \
	code=$$(curl -s -o /dev/null -w '%{http_code}' -H "Authorization: Bearer $$key" "http://localhost:$${PLATFORM_REGISTRY_PORT:-8010}/llm-settings/active-model"); \
	if [ "$$code" = "401" ]; then \
		echo "❌ ADMIN_API_KEY in .env doesn't match what platform-registry is running with — after editing .env, run 'make up' to recreate it"; exit 1; \
	fi; \
	echo "  ✓ admin key accepted by platform-registry ($$code)"
	@key="$${ADMIN_API_KEY:-angel2026}"; \
	n=$$(curl -s -H "Authorization: Bearer $$key" "http://localhost:$${PLATFORM_REGISTRY_PORT:-8010}/entitlements/admin" | grep -o '"slug"' | wc -l); \
	if [ "$$n" -gt 0 ]; then echo "  ✓ admin tenant is entitled to $$n scenario(s)"; \
	else echo "❌ admin tenant has 0 entitled scenarios — scenario seeding may have failed, check: docker compose logs platform-registry"; exit 1; fi
	@for host in prediction assistant rag-agent; do \
		code=$$(curl -s -o /dev/null -w '%{http_code}' "http://$$host.localhost/healthz"); \
		if [ "$$code" = "200" ]; then echo "  ✓ $$host.localhost reachable ($$code)"; \
		else echo "❌ $$host.localhost -> $$code — this is the exact failure behind a browser 'Failed to fetch'. Check: docker compose ps, docker compose logs $$host, and 'getent hosts $$host.localhost'"; exit 1; fi; \
	done
	@code=$$(curl -s -o /dev/null -w '%{http_code}' "http://aiopen.localhost/"); \
	if [ "$$code" = "200" ]; then echo "  ✓ aiopen.localhost reachable ($$code)"; \
	else echo "❌ aiopen.localhost -> $$code — check: docker compose logs ui-react, and that port 80 isn't already used by something else on this machine"; exit 1; fi
ifeq (,$(filter langfuse,$(VERIFY_SKIP)))
	@code=$$(curl -s -o /dev/null -w '%{http_code}' "http://langfuse.localhost/api/public/health"); \
	if [ "$$code" = "200" ]; then echo "  ✓ langfuse.localhost reachable ($$code) — GenAI monitor"; \
	else echo "❌ langfuse.localhost -> $$code — check: logs of langfuse-web / clickhouse (first boot runs migrations for a few minutes)"; exit 1; fi
else
	@echo "  – langfuse.localhost skipped (VERIFY_SKIP)"
endif
ifeq (,$(filter mlflow,$(VERIFY_SKIP)))
	@code=$$(curl -s -o /dev/null -w '%{http_code}' "http://mlflow.localhost/health"); \
	if [ "$$code" = "401" ]; then echo "  ✓ mlflow.localhost reachable ($$code, admin-basicauth in front) — MLOps monitor"; \
	else echo "❌ mlflow.localhost -> $$code (expected 401 from the admin-basicauth gate) — check: logs of mlflow"; exit 1; fi
else
	@echo "  – mlflow.localhost skipped (VERIFY_SKIP)"
endif
	@echo "✓ admin tenant verified — http://aiopen.localhost is ready for the 'admin' User dropdown login"
	@demo_key="$${ENGINEERING_DEMO_API_KEY:-}"; \
	if [ -z "$$demo_key" ]; then \
		echo "ℹ️  ENGINEERING_DEMO_API_KEY not set in .env — skipping engineering-demo tenant checks"; \
		exit 0; \
	fi; \
	echo "🔎 verifying engineering-demo tenant is scoped correctly..."; \
	code=$$(curl -s -o /dev/null -w '%{http_code}' -H "Authorization: Bearer $$demo_key" "http://localhost:$${PLATFORM_REGISTRY_PORT:-8010}/auth/verify-engineering-demo-key"); \
	if [ "$$code" != "200" ]; then \
		echo "❌ ENGINEERING_DEMO_API_KEY in .env doesn't match what platform-registry is running with ($$code) — after editing .env, run 'make up' to recreate it"; exit 1; \
	fi; \
	echo "  ✓ engineering demo key accepted by platform-registry ($$code)"; \
	slugs=$$(curl -s -H "Authorization: Bearer $$demo_key" "http://localhost:$${PLATFORM_REGISTRY_PORT:-8010}/entitlements/engineering-demo" | grep -o '"slug":"[a-z_]*"' | sort); \
	expected=$$(printf '"slug":"electric_motor"\n"slug":"energy_building"\n"slug":"mpm"'); \
	if [ "$$slugs" = "$$expected" ]; then \
		echo "  ✓ engineering-demo tenant is entitled to exactly mpm/electric_motor/energy_building"; \
	else \
		echo "❌ engineering-demo tenant entitlements don't match — expected mpm/electric_motor/energy_building, got:"; echo "$$slugs"; exit 1; \
	fi; \
	code=$$(curl -s -o /dev/null -w '%{http_code}' -X POST -H "Authorization: Bearer $$demo_key" -H "Content-Type: application/json" -d '{"records":[]}' "http://prediction.localhost/predict/churn"); \
	if [ "$$code" = "403" ]; then \
		echo "  ✓ engineering-demo key correctly denied access to an out-of-scope scenario (churn -> 403)"; \
	else \
		echo "❌ engineering-demo key was NOT denied access to churn (got $$code, expected 403) — scoping enforcement is broken"; exit 1; \
	fi; \
	echo "✓ engineering-demo tenant verified — scoped to exactly mpm/electric_motor/energy_building"

# ── k3s (local single-node, via k3d — see k8s/README.md) ───────────────────────
# Dev-parity only: same *.localhost hostnames/routing as docker-compose, on a local
# k3d cluster instead. Not a production/multi-node setup — no registry, no
# imagePullSecrets; images are built locally and imported straight into k3d's
# containerd. Run these roughly in order: cluster -> build -> import -> secrets -> up
# -> wait -> (pipeline) -> verify.

K3S_CLUSTER ?= ai-circus
K3S_IMAGES   = platform-registry etl-tabular prediction llm-gateway assistant training etl-vectorize rag-agent form-agent agui-voice data-platform-manager
# Deployments `k3s-lite`/`k3s-resume-lite` scale to 0 — the heaviest pods the day-to-day demo never
# touches (measured RSS on a running cluster: agui-voice ~830Mi, mlflow ~350Mi). Langfuse
# (+ clickhouse/valkey) and data-platform-manager (the admin Platform health dashboard) deliberately
# stay on. Override per call to trim further, e.g. K3S_LITE_SKIP="mlflow agui-voice langfuse-web langfuse-worker".
K3S_LITE_SKIP ?= mlflow agui-voice
# `k3s-demo` goes further for a live demo on a 16 GB laptop: everything that serves no scenario
# (observability + the admin Platform dashboard) is scaled to 0 — ~2.5 GB RSS. Scenarios of every
# kind, deep learning included, keep working; LLM traces are simply not recorded meanwhile.
K3S_DEMO_SKIP     ?= mlflow agui-voice langfuse-web langfuse-worker data-platform-manager
K3S_DEMO_SKIP_STS ?= clickhouse
# ...but `k3s-demo-off` leaves these off (voice is heavy and rarely used; `make k3s-full K3S_LITE_SKIP=agui-voice` brings it back).
K3S_DEMO_KEEP_OFF ?= agui-voice

K3S_SUBNET   ?=  # optional, e.g. 172.28.0.0/16 — pins static node IPs so a Docker/host restart can't swap them (k3d marks --subnet experimental; see k8s/README.md)
K3S_VERSION  ?= v1.35.5-k3s1
# auto: a GPU-enabled cluster whenever Docker can pass the host GPU through (NVIDIA
# Container Toolkit — `sudo ./scripts/setup_gpu_containers.sh`); 1 forces it, 0 never.
K3S_GPU      ?= auto

k3s-cluster: ## Create the local k3d cluster (idempotent) — port 80 for Traefik, ./scenarios bind-mounted for hostPath volumes; K3S_SUBNET=… pins node IPs; K3S_GPU=auto|1|0 adds the host GPU (infra/k3s-gpu/)
	@./scripts/k3s_cluster_create.sh "$(K3S_CLUSTER)" "$(strip $(K3S_GPU))" "$(strip $(K3S_VERSION))" "$(strip $(K3S_SUBNET))"

k3s-gpu-smoke: ## Prove a pod can use the cluster GPU (nvidia RuntimeClass + device plugin): runs nvidia-smi once — needs a K3S_GPU cluster
	@kubectl -n ai-circus delete pod gpu-smoke --ignore-not-found >/dev/null
	@kubectl apply -f k8s/jobs/gpu-smoke-pod.yaml >/dev/null
	@kubectl -n ai-circus wait --for=jsonpath='{.status.phase}'=Succeeded pod/gpu-smoke --timeout=180s \
		|| { kubectl -n ai-circus describe pod gpu-smoke | tail -15; exit 1; }
	@kubectl -n ai-circus logs gpu-smoke
	@kubectl -n ai-circus delete pod gpu-smoke --ignore-not-found >/dev/null
	@echo "✓ the cluster GPU works — in-cluster deep-learning training will request it"

k3s-build: ## Build every service image locally (same Dockerfiles docker-compose uses), tagged ai-circus/<service>:local
	@mkdir -p demo/themes
	@for svc in $(K3S_IMAGES); do \
		echo "── ai-circus/$$svc:local ──"; \
		docker build -f "services/$$svc/Dockerfile" -t "ai-circus/$$svc:local" . || exit 1; \
	done
	@echo "── ai-circus/mlflow:local (infra/mlflow/Dockerfile — MLOps monitor) ──"
	@docker build -f infra/mlflow/Dockerfile -t ai-circus/mlflow:local infra/mlflow || exit 1
	@echo "── ai-circus/keycloak:local (infra/keycloak/Dockerfile — pre-built, realm baked in) ──"
	@docker build -t ai-circus/keycloak:local infra/keycloak || exit 1
	@$(MAKE) --no-print-directory k3s-ui-image
	@echo "✓ all images built"

k3s-ui-image: ## Build only the ui-react image (same Vite build args as k3s-build)
	@docker build -f ui-react/Dockerfile -t ai-circus/ui-react:local \
		--build-arg VITE_KEYCLOAK_ISSUER="$(VITE_KEYCLOAK_ISSUER)" \
		--build-arg VITE_KEYCLOAK_CLIENT_ID="$(if $(VITE_KEYCLOAK_CLIENT_ID),$(VITE_KEYCLOAK_CLIENT_ID),ui-react)" \
		--build-arg VITE_KEYCLOAK_AUDIENCE="$(VITE_KEYCLOAK_AUDIENCE)" \
		--build-arg VITE_DEV_MODE="$(if $(DEV_MODE),$(DEV_MODE),false)" \
		--build-arg VITE_DEV_ORG_ID="$(if $(DEV_ORG_ID),$(DEV_ORG_ID),demo)" \
		.

k3s-import: ## Import every ai-circus/*:local image into the k3d cluster's containerd (one batched import)
	@k3d image import $(foreach svc,$(K3S_IMAGES) ui-react mlflow keycloak,ai-circus/$(svc):local) -c "$(K3S_CLUSTER)"
	@echo "✓ all images imported into k3d cluster '$(K3S_CLUSTER)'"

k3s-secrets: ## Generate the app-env/traefik-basicauth/seaweedfs-s3-config k8s Secrets from .env/infra — never committed, re-run any time those change
	@./scripts/k3s_generate_secrets.sh

k3s-up: ## Apply every manifest under k8s/base (namespace, infra, backend services, ingress) — plus, on a GPU cluster, k3s-gpu-telemetry
	@kubectl apply -k k8s/base
	@$(MAKE) --no-print-directory k3s-gpu-telemetry
	@echo "✓ k8s/base applied — 'make k3s-wait' to wait for it to actually be ready"

k3s-gpu-telemetry: ## GPU clusters only (no-op otherwise; k3s creates the `nvidia` RuntimeClass even without a GPU, so detect a node with allocatable nvidia.com/gpu): give data-platform-manager read-only GPU access (k8s/gpu/) for the admin Platform → Monitor tab — never requests nvidia.com/gpu
	@if kubectl get nodes -o jsonpath='{range .items[*]}{.status.allocatable.nvidia\.com/gpu}{"\n"}{end}' 2>/dev/null | awk '{s+=$$1} END {exit !(s>0)}'; then \
		kubectl -n ai-circus patch deployment data-platform-manager --patch-file k8s/gpu/data-platform-manager-gpu-telemetry.yaml \
		&& echo "⚡ GPU cluster — data-platform-manager can read GPU telemetry (Platform → Monitor)"; \
	fi

k3s-wait: ## Wait for postgres/qdrant/seaweedfs and every backend Deployment to report Ready
	@echo "⏳ waiting for postgres/qdrant/seaweedfs..."
	@kubectl -n ai-circus rollout status statefulset/postgres --timeout=180s
	@kubectl -n ai-circus rollout status statefulset/qdrant --timeout=60s
	@kubectl -n ai-circus rollout status statefulset/seaweedfs --timeout=60s
	@echo "⏳ waiting for keycloak (first boot imports the realm — can take a couple of minutes)..."
	@kubectl -n ai-circus rollout status deployment/keycloak --timeout=180s
	@echo "⏳ waiting for llm-gateway (loads its local embedding model before Ready — a brand-new cluster downloads it first, ~670 MB)..."
	@kubectl -n ai-circus rollout status deployment/llm-gateway --timeout=600s
	@for svc in platform-registry prediction assistant rag-agent form-agent data-platform-manager ui-react; do \
		echo "⏳ waiting for $$svc..."; \
		kubectl -n ai-circus rollout status deployment/$$svc --timeout=120s || exit 1; \
	done
	@echo "⏳ waiting for agui-voice (Ready once its STT/TTS models are warm — a new cluster downloads them first)..."
	@kubectl -n ai-circus rollout status deployment/agui-voice --timeout=600s
	@echo "⏳ waiting for the observability stack (Langfuse's first boot migrates Postgres + ClickHouse — a few minutes on a laptop)..."
	@kubectl -n ai-circus rollout status statefulset/clickhouse --timeout=180s
	@for svc in mlflow langfuse-web langfuse-worker; do \
		echo "⏳ waiting for $$svc..."; \
		kubectl -n ai-circus rollout status deployment/$$svc --timeout=300s || exit 1; \
	done
	@echo "✓ all pods ready"
	@$(MAKE) k3s-portforward

k3s-pipeline: ## Run the one-shot ETL -> training pipeline (every tabular_ml scenario) as k8s Jobs (mirrors `make pipeline`) — REQUIRED before any tabular_ml scenario can serve a prediction; a fresh/recreated cluster has no trained models until this runs
	@kubectl -n ai-circus delete job etl-tabular training --ignore-not-found
	@kubectl apply -f k8s/jobs/etl-tabular-job.yaml
	@kubectl -n ai-circus wait --for=condition=complete job/etl-tabular --timeout=300s
	@kubectl apply -f k8s/jobs/training-job.yaml
	@kubectl -n ai-circus wait --for=condition=complete job/training --timeout=600s
	@kubectl -n ai-circus rollout restart deployment/prediction
	@echo "✓ tabular_ml pipeline complete (every scenario in SCENARIOS, empty/unset = all) — documents are separate: make k3s-vectorize"

k3s-vectorize: ## Index every scenario's documents into Qdrant and the tenant's bucket (RAG, forms, the case desk's reading room) — REQUIRED on a fresh cluster for those; ~20 min on CPU, so run it detached
	@kubectl -n ai-circus delete job etl-vectorize --ignore-not-found
	@kubectl apply -f k8s/jobs/etl-vectorize-job.yaml
	@kubectl -n ai-circus wait --for=condition=complete job/etl-vectorize --timeout=1800s
	@echo "✓ documents indexed (every scenario with documents)"

k3s-verify: ## Port-forward platform-registry, then reuse `make verify`'s curl checks unchanged (same *.localhost + localhost:$${PLATFORM_REGISTRY_PORT:-8010} assertions, now against k3d's Traefik)
	@kubectl -n ai-circus port-forward svc/platform-registry "$${PLATFORM_REGISTRY_PORT:-8010}:8000" >/tmp/k3s-verify-port-forward.log 2>&1 & \
	pf_pid=$$!; \
	trap "kill $$pf_pid 2>/dev/null" EXIT; \
	sleep 2; \
	$(MAKE) verify

EMBED_VARIANT ?= int8
k3s-embed-onnx: ## Run local-embed on ONNX Runtime instead of torch: exports the model once on the host, copies EMBED_VARIANT (int8 default, fp32, or off to go back to torch) into llm-gateway's model volume and restarts it
	@./scripts/k3s_embed_onnx.sh $(EMBED_VARIANT)

IDLE_SCENARIOS ?= Customer Churn Prediction
k3s-idle-check: ## Open every tab of the scenarios in IDLE_SCENARIOS (card titles, comma-separated) in headless Chromium and fail if one still draws >2 frames/s or >15% CPU idle (needs playwright-core; PW_MODULE/MAX_FPS/MAX_CPU tune it)
	@set -a; . ./.env; set +a; SCENARIO_TITLES="$(IDLE_SCENARIOS)" node .claude/skills/playwright-headless-verify/k3s-idle-check.js

k3s-down: k3s-portforward-stop ## Delete every applied k8s/base manifest (StatefulSet PVCs are retained by default — delete the k3d cluster entirely for a full wipe: `k3d cluster delete $(K3S_CLUSTER)`)
	@kubectl delete -k k8s/base --ignore-not-found

k3s-all: k3s-cluster k3s-build k3s-import k3s-secrets k3s-up k3s-wait ## One-shot: cluster -> build -> import -> secrets -> up -> wait (run `make k3s-pipeline` yourself afterward if you need the churn ETL/training data)
	@echo "✓ k3s cluster '$(K3S_CLUSTER)' is up — http://aiopen.localhost"

k3s-all-lite: k3s-cluster k3s-build k3s-import k3s-secrets k3s-up k3s-lite k3s-wait ## `k3s-all`, but the K3S_LITE_SKIP pods (default mlflow, agui-voice) are scaled to 0 right after `k3s-up` so `k3s-wait` never waits on them — images are still built/imported, so `make k3s-full` works later without a rebuild
	@echo "✓ k3s cluster '$(K3S_CLUSTER)' is up in lite mode — http://aiopen.localhost ('make k3s-full' brings the skipped pods back)"

k3s-data-platform-up: k3s-data-core-up ## Alias of k3s-data-core-up (the Data Platform's core tier)

k3s-data-platform-down: k3s-data-core-down ## Alias of k3s-data-core-down

k3s-pause: k3s-portforward-stop ## Stop the k3d cluster's containers to free CPU/RAM while keeping all cluster state (pods, volumes) — resume with `make k3s-resume`
	@k3d cluster stop "$(K3S_CLUSTER)"
	@echo "✓ k3d cluster '$(K3S_CLUSTER)' stopped — resume with 'make k3s-resume'"

k3s-resume: ## Start a previously paused k3d cluster back up, then wait for its node to be Ready (at most 5 min)
	@# k3d's last start step (injecting host.k3d.internal into CoreDNS, which nothing here uses) can hang for
	@# minutes after the containers are up: give the start 90 s, then wait for what matters, the node being Ready.
	@timeout --foreground 90 k3d cluster start --wait=false "$(K3S_CLUSTER)" >/dev/null 2>&1 || true
	@kubectl --context "k3d-$(K3S_CLUSTER)" wait --for=condition=Ready node --all --timeout=300s >/dev/null
	@echo "✓ k3d cluster '$(K3S_CLUSTER)' started — 'make k3s-wait' to confirm pods are Ready (also restarts the platform-registry port-forward)"

k3s-lite: ## Scale the rarely-used Deployments in K3S_LITE_SKIP (default: mlflow agui-voice) to 0 replicas on the running cluster to save RAM — Langfuse stays on; undo with `make k3s-full`
	@for svc in $(K3S_LITE_SKIP); do \
		kubectl -n ai-circus scale deployment/$$svc --replicas=0 || exit 1; \
	done
	@echo "✓ lite mode — scaled to 0: $(K3S_LITE_SKIP) (voice mode / MLflow will be unavailable; 'make k3s-full' restores)"

k3s-full: ## Scale every Deployment `k3s-lite` turned off back to 1 replica (the full k8s/base set again)
	@for svc in $(K3S_LITE_SKIP); do \
		kubectl -n ai-circus scale deployment/$$svc --replicas=1 || exit 1; \
	done
	@echo "✓ full mode — scaled back to 1: $(K3S_LITE_SKIP) — 'make k3s-wait' to confirm they are Ready"

k3s-resume-lite: k3s-resume k3s-lite k3s-wait ## Resume a paused cluster WITHOUT the heavy rarely-used pods (default skips mlflow and agui-voice — ~1.2 GB less RSS), then wait for the rest to be Ready
	@echo "✓ k3d cluster '$(K3S_CLUSTER)' resumed in lite mode — http://aiopen.localhost ('make k3s-full' brings the skipped pods back)"

k3s-demo: ## Demo mode — scale every pod no scenario needs (K3S_DEMO_SKIP + K3S_DEMO_SKIP_STS: MLflow, voice, Langfuse + clickhouse, the admin Platform dashboard) to 0, then hand the Linux page cache back to Windows/the host; undo with `make k3s-demo-off`
	@$(MAKE) --no-print-directory k3s-lite K3S_LITE_SKIP="$(K3S_DEMO_SKIP)"
	@for sts in $(K3S_DEMO_SKIP_STS); do \
		kubectl -n ai-circus scale statefulset/$$sts --replicas=0 || exit 1; \
	done
	@sync; if sudo -n true 2>/dev/null; then \
		echo 3 | sudo -n tee /proc/sys/vm/drop_caches >/dev/null && echo "✓ page cache dropped"; \
	else \
		echo "ℹ skipped dropping the page cache (needs sudo) — run: sync && echo 3 | sudo tee /proc/sys/vm/drop_caches"; \
	fi
	@free -m | head -2
	@echo "✓ demo mode — off: $(K3S_DEMO_SKIP) $(K3S_DEMO_SKIP_STS) (no LLM traces, no admin Platform view; 'make k3s-demo-off' restores)"
	@echo "   verify with: make k3s-verify VERIFY_SKIP=\"langfuse mlflow\""

k3s-demo-off: ## Undo `k3s-demo` — scale K3S_DEMO_SKIP (minus K3S_DEMO_KEEP_OFF: voice) + K3S_DEMO_SKIP_STS back to 1 replica and wait for the platform to be Ready
	@for sts in $(K3S_DEMO_SKIP_STS); do \
		kubectl -n ai-circus scale statefulset/$$sts --replicas=1 || exit 1; \
	done
	@$(MAKE) --no-print-directory k3s-full K3S_LITE_SKIP="$(filter-out $(K3S_DEMO_KEEP_OFF),$(K3S_DEMO_SKIP))"
	@$(MAKE) --no-print-directory k3s-wait

k3s-clickhouse-drop-system-logs: ## One-shot for a cluster created before ClickHouse's system logs were disabled (k8s/base/langfuse.yaml): drop the leftover system.*_log tables — ClickHouse's own self-telemetry, never Langfuse data — whose merges otherwise retry at the memory limit forever (~1 CPU)
	@kubectl -n ai-circus exec clickhouse-0 -- sh -c '\
		q() { clickhouse-client --user "$$CLICKHOUSE_USER" --password "$$CLICKHOUSE_PASSWORD" -d system --param_e=MergeTree --param_keep=crash_log -q "$$1"; }; \
		for t in $$(q "SELECT name FROM system.tables WHERE database = currentDatabase() AND engine = {e:String} AND name != {keep:String}"); do \
			q "DROP TABLE $$t SYNC" && echo "dropped system.$$t" || exit 1; \
		done'

k3s-portforward: ## Standing port-forward to platform-registry (the browser reaches it directly) — a systemd user service where available, so it survives reboots and pod restarts (scripts/k3s_portforward.sh); auto-run by k3s-wait, safe to re-run
	@./scripts/k3s_portforward.sh start "$(K3S_CLUSTER)" "$${PLATFORM_REGISTRY_PORT:-8010}"

k3s-portforward-stop: ## Stop the platform-registry port-forward (its systemd service stays enabled for the next boot)
	@./scripts/k3s_portforward.sh stop "$(K3S_CLUSTER)"

k3s-portforward-uninstall: ## Remove the port-forward's systemd user service — back to re-running `make k3s-portforward` after every reboot
	@./scripts/k3s_portforward.sh uninstall "$(K3S_CLUSTER)"

k3s-mcp-portforward: ## OPTIONAL: standing port-forwards to the MCP doors — rag-agent on localhost:8031, data-api on localhost:8032 when the Data Platform is up — and to the MCP gateway in front of them (llm-gateway's /mcp/{slug},{slug}) on localhost:8033, so MCP clients on this machine (Claude Code…) reach them where *.localhost does not resolve (docs/adr/0019, 0020); same systemd user service as k3s-portforward
	@./scripts/k3s_portforward.sh start "$(K3S_CLUSTER)" "$${RAG_AGENT_MCP_PORT:-8031}" rag-agent
	@if kubectl -n ai-circus get deployment/data-api >/dev/null 2>&1; then ./scripts/k3s_portforward.sh start "$(K3S_CLUSTER)" "$${DATA_API_MCP_PORT:-8032}" data-api; fi
	@./scripts/k3s_portforward.sh start "$(K3S_CLUSTER)" "$${MCP_GATEWAY_PORT:-8033}" llm-gateway

k3s-mcp-portforward-uninstall: ## Remove the MCP port-forwards and their systemd user services
	@./scripts/k3s_portforward.sh uninstall "$(K3S_CLUSTER)" "$${RAG_AGENT_MCP_PORT:-8031}" rag-agent
	@./scripts/k3s_portforward.sh uninstall "$(K3S_CLUSTER)" "$${DATA_API_MCP_PORT:-8032}" data-api
	@./scripts/k3s_portforward.sh uninstall "$(K3S_CLUSTER)" "$${MCP_GATEWAY_PORT:-8033}" llm-gateway

# ── Deep learning scenarios (optional — NEVER part of `make all`/`k3s-all`) ─────
# `kind: deep_learning` scenarios (scenarios/symptom_triage, scenarios/chest_xray_pneumonia,
# scenarios/solar_cell_inspection, scenarios/pcb_visual_inspection, scenarios/screw_visual_inspection) fine-tune Hugging Face models — or, for
# `task: anomaly_detection`, build a memory bank from a frozen one: minutes on a GPU,
# far longer on a CPU — so training only
# ever runs from these explicit targets (or the admin console's Platform → Deep Learning
# tab). `dl-train-*` trains on THIS machine (its GPU, if any) and publishes to the running
# stack's SeaweedFS; the k3s-dl-* targets below deploy the separate dl-inference service.

DL_SCENARIO_NLP ?= symptom_triage
# Comma-separated: the fine-tuned image classifiers (chest X-ray, solar-cell EL).
DL_SCENARIO_CV  ?= chest_xray_pneumonia,solar_cell_inspection,wildfire_smoke_watch
# Comma-separated: both manufacturing anomaly detectors (PCB, and the harder machined screw).
DL_SCENARIO_ANOMALY ?= pcb_visual_inspection,screw_visual_inspection

dl-gpu-check: ## Report whether this machine has an NVIDIA GPU dl-train-* can use (and what the k3s cluster exposes)
	@if command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi -L >/dev/null 2>&1; then \
		echo "⚡ host GPU: $$(nvidia-smi --query-gpu=name,memory.total,driver_version --format=csv,noheader | head -1) — dl-train-* will fine-tune on it"; \
	else echo "ℹ️  no host NVIDIA GPU — dl-train-* would use each scenario's reduced CPU budget (asks first)"; fi
	@gpus=$$(kubectl get nodes -o jsonpath='{range .items[*]}{.status.allocatable.nvidia\.com/gpu}{"\n"}{end}' 2>/dev/null | awk '{s+=$$1} END {print s+0}'); \
	echo "   k3s cluster GPUs (nvidia.com/gpu allocatable): $${gpus:-0} — in-cluster training (k3s-dl-train-*, admin console) uses CPU unless > 0"

dl-data: ## Download + checksum-verify every deep_learning scenario's public data into SeaweedFS (no training; SCENARIOS=… to narrow)
	@./scripts/dl_train_host.sh --download-only "$(SCENARIOS)"

dl-artifacts-export: ## Pack trained deep_learning models from this stack into FILE (default dl-models.tar) to serve them from another machine — SCENARIOS=… to narrow
	@cd services/dl-training && uv run -q --frozen python ../../scripts/dl_artifacts.py export "$(abspath $(or $(FILE),dl-models.tar))" --scenarios "$(SCENARIOS)"

dl-artifacts-import: ## Publish a dl-artifacts-export FILE into this stack; then: kubectl -n ai-circus rollout restart deployment/dl-inference
	@cd services/dl-training && uv run -q --frozen python ../../scripts/dl_artifacts.py import "$(abspath $(or $(FILE),dl-models.tar))"

dl-train: ## Fine-tune every deep_learning scenario on this machine (GPU if present; CPU asks first) and publish to SeaweedFS — SCENARIOS=… to narrow
	@./scripts/dl_train_host.sh "$(SCENARIOS)"

text-embeddings: ## Embed free-text tabular scenarios' reviews (toxic_leadership) on this machine's GPU into SeaweedFS for their transformer challenger — then re-run training
	@./scripts/dl_train_host.sh --embed-texts "$(SCENARIOS)"

k3s-text-embeddings: text-embeddings ## text-embeddings, then re-run the training Job (champion + challenger) and reload prediction
	@kubectl -n ai-circus delete job training --ignore-not-found
	@kubectl apply -f k8s/jobs/training-job.yaml
	@kubectl -n ai-circus wait --for=condition=complete job/training --timeout=900s
	@kubectl -n ai-circus rollout restart deployment/prediction

dl-train-nlp: ## Fine-tune the NLP scenario (BioClinical ModernBERT, symptom triage) on this machine's GPU
	@./scripts/dl_train_host.sh "$(DL_SCENARIO_NLP)"

dl-train-cv: ## Fine-tune the computer-vision scenarios (ConvNeXt V2: chest X-ray, solar-cell EL) on this machine's GPU
	@./scripts/dl_train_host.sh "$(DL_SCENARIO_CV)"

dl-train-anomaly: ## Build the CV anomaly detectors (frozen DINOv2 + memory bank; PCB + screw inspection) on this machine's GPU
	@./scripts/dl_train_host.sh "$(DL_SCENARIO_ANOMALY)"

# dl-training image's torch build: auto = the CUDA build when the cluster advertises
# nvidia.com/gpu (it still runs on CPU), else the ~1 GB smaller CPU build; or force cpu|gpu.
DL_TRAINING_TORCH ?= auto
DL_TRAINING_TORCH_RESOLVED = $(if $(filter auto,$(strip $(DL_TRAINING_TORCH))),$(shell kubectl get nodes -o jsonpath='{range .items[*]}{.status.allocatable.nvidia\.com/gpu}{"\n"}{end}' 2>/dev/null | awk '{s+=$$1} END {print (s>0) ? "gpu" : "cpu"}'),$(strip $(DL_TRAINING_TORCH)))

k3s-dl-build: ## Build + import the Deep Learning images (dl-inference, dl-training) into k3d — separate from k3s-build so the ~2 GB torch image is opt-in
	@docker build -f services/dl-inference/Dockerfile -t ai-circus/dl-inference:local . || exit 1
	@docker build -f services/dl-training/Dockerfile --build-arg DL_TRAINING_TORCH=$(DL_TRAINING_TORCH_RESOLVED) -t ai-circus/dl-training:local . || exit 1
	@k3d image import ai-circus/dl-inference:local ai-circus/dl-training:local -c "$(K3S_CLUSTER)"
	@echo "✓ Deep Learning images built + imported (dl-training torch=$(DL_TRAINING_TORCH_RESOLVED))"

k3s-dl-up: ## Deploy the optional Deep Learning overlay (k8s/deep-learning/: dl-inference) and wait for it — models come from `make dl-train*` / k3s-dl-train-*
	@kubectl apply -k k8s/deep-learning
	@kubectl -n ai-circus rollout status deployment/dl-inference --timeout=180s
	@echo "✓ dl-inference up — http://dl-inference.localhost (healthz); the deep-learning scenarios appear in http://aiopen.localhost"

k3s-dl-down: ## Remove the Deep Learning overlay (trained models stay in SeaweedFS)
	@kubectl delete -k k8s/deep-learning --ignore-not-found

k3s-vllm-up: ## Deploy the optional vLLM overlay (k8s/llm-serving/, needs a GPU, holds it whole): llm-gateway's vllm-qwen model. The first start pulls ~33 GB of image and 3.1 GB of weights (ADR 0017)
	@kubectl apply -k k8s/llm-serving
	@kubectl -n ai-circus rollout status deployment/vllm --timeout=3600s
	@echo "✓ vLLM up — pick 'vllm-qwen' in Settings, or: LLM_MODEL=vllm-qwen"

k3s-vllm-down: ## Remove the vLLM overlay and free the GPU. Keeps the weights' volume: `kubectl -n ai-circus delete pvc vllm-model-cache` to reclaim it
	@kubectl -n ai-circus delete deployment,service vllm --ignore-not-found

k3s-chat-ui-up: ## OPTIONAL chat UI (k8s/chat-ui/, ADR 0021): Open WebUI at http://chat.localhost, Keycloak sign-in, MCP doors through the gateway with each user's token. Brings the live Keycloak realm up to infra/keycloak/realm-export.json, creates the lite-demo tenant (analyst@ / manager@lite-demo.local, password CHAT_UI_DEMO_PASSWORD in .env) and its entitlements. Never part of k3s-all
	@./scripts/k3s_portforward.sh status "$(K3S_CLUSTER)" >/dev/null 2>&1 || $(MAKE) --no-print-directory k3s-portforward
	@python3 scripts/chat_ui_identity.py --cluster "$(K3S_CLUSTER)"
	@./scripts/k3s_generate_secrets.sh >/dev/null
	@kubectl apply -k k8s/chat-ui
	@kubectl -n ai-circus rollout status deployment/open-webui --timeout=900s
	@echo "✓ chat UI up — http://chat.localhost (sign in with Keycloak; the first user to sign in becomes its admin)"

k3s-chat-ui-down: ## Remove the optional chat UI. Keeps its data volume (`kubectl -n ai-circus delete pvc open-webui-data` to reclaim it) and the Keycloak demo tenant
	@kubectl -n ai-circus delete deployment,service,ingressroute open-webui --ignore-not-found

k3s-librechat-up: ## OPTIONAL second chat UI (k8s/chat-ui-librechat/, ADR 0026): LibreChat (MIT) + its MongoDB at http://librechat.localhost, Keycloak sign-in, every mcp/catalog.yaml server through the gateway with each user's token. Same identity step and demo users as k3s-chat-ui-up. On a 16 GB laptop run one chat UI at a time. Never part of k3s-all
	@if kubectl -n ai-circus get deployment open-webui >/dev/null 2>&1; then \
		echo "ℹ Open WebUI is deployed too: on a 16 GB laptop run one chat UI at a time (make k3s-chat-ui-down)"; fi
	@./scripts/k3s_portforward.sh status "$(K3S_CLUSTER)" >/dev/null 2>&1 || $(MAKE) --no-print-directory k3s-portforward
	@python3 scripts/chat_ui_identity.py --cluster "$(K3S_CLUSTER)"
	@./scripts/k3s_generate_secrets.sh >/dev/null
	@kubectl apply -k k8s/chat-ui-librechat
	@kubectl -n ai-circus rollout status deployment/librechat-mongodb --timeout=600s
	@kubectl -n ai-circus rollout status deployment/librechat --timeout=900s
	@echo "✓ LibreChat up — http://librechat.localhost (sign in with Keycloak; the first user to sign in becomes its admin)"

k3s-librechat-down: ## Remove the optional LibreChat UI and its MongoDB. Keeps the database volume (`kubectl -n ai-circus delete pvc librechat-mongodb-data` to reclaim it) and the Keycloak demo tenant
	@kubectl -n ai-circus delete deployment,service librechat librechat-mongodb --ignore-not-found
	@kubectl -n ai-circus delete ingressroute librechat --ignore-not-found
	@kubectl -n ai-circus delete configmap -l app.kubernetes.io/part-of=librechat --ignore-not-found >/dev/null

# The MCP lite profile (docs/adr/0027): the MCP Lite Stack alone on its own k3d cluster (own kubeconfig file; the
# default kubeconfig and its context are never touched). It holds port 80 as the framework cluster does: pause one
# to run the other. CHAT_UI picks the chat UI (open-webui | librechat); OBS=1 adds the observability bundle
# (k3s-obs-up, ~1 GiB, run against the lite cluster) and makes k3s-mcp-lite-verify check its signals.
MCP_LITE_CLUSTER ?= mcp-lite
CHAT_UI ?= open-webui
MCP_LITE = MCP_LITE_CLUSTER="$(MCP_LITE_CLUSTER)" CHAT_UI="$(CHAT_UI)" OBS="$(OBS)" K3S_VERSION="$(strip $(K3S_VERSION))" ./scripts/k3s_mcp_lite.sh

k3s-mcp-lite: ## OPTIONAL MCP lite profile (ADR 0027) on its own k3d cluster MCP_LITE_CLUSTER (default mcp-lite): Keycloak, the AI gateway (llm-gateway: models + MCP gateway), crm-mcp + crm-api (Level 3) and one chat UI (CHAT_UI=open-webui|librechat), nothing else of the framework (~3 GB; OBS=1 adds the observability bundle, ~1 GiB). Refuses while another k3d cluster holds port 80 (make k3s-pause first)
	@$(MCP_LITE) up

k3s-mcp-lite-verify: ## Check the MCP lite profile without a model: each demo user signs in through Keycloak's login pages, then lists and calls every kit server's tools through the gateway with that token, against mcp/catalog.yaml's grants; with the observability bundle deployed, also that those calls reached metrics, audit logs and traces, and that no log line carries a token
	@$(MCP_LITE) verify

k3s-mcp-lite-down: ## Delete the MCP lite profile's k3d cluster (volumes included). Bring the framework cluster back with make k3s-resume
	@$(MCP_LITE) down

K3S_MCP_EXAMPLE_IMAGES = crm-api crm-mcp

k3s-mcp-examples-up: ## OPTIONAL example of an MCP server in front of an existing API (k8s/mcp-examples/, ADR 0022): crm-api (a customer API) and crm-mcp (built with libs/mcp-kit), reached through the MCP gateway at /mcp/crm. Builds + imports both images, syncs the Keycloak realm (clients, token exchange), applies. Never part of k3s-all
	@for svc in $(K3S_MCP_EXAMPLE_IMAGES); do \
		echo "── ai-circus/$$svc:local ──"; \
		docker build -f "services/$$svc/Dockerfile" -t "ai-circus/$$svc:local" . || exit 1; \
	done
	@k3d image import $(foreach svc,$(K3S_MCP_EXAMPLE_IMAGES),ai-circus/$(svc):local) -c "$(K3S_CLUSTER)"
	@./scripts/k3s_portforward.sh status "$(K3S_CLUSTER)" >/dev/null 2>&1 || $(MAKE) --no-print-directory k3s-portforward
	@python3 scripts/chat_ui_identity.py --cluster "$(K3S_CLUSTER)"
	@./scripts/k3s_generate_secrets.sh >/dev/null
	@$(MCP_TLS) --k8s
	@kubectl apply -k k8s/mcp-examples
	@kubectl -n ai-circus rollout restart deployment/crm-api deployment/crm-mcp >/dev/null
	@kubectl -n ai-circus rollout status deployment/crm-api --timeout=300s
	@kubectl -n ai-circus rollout status deployment/crm-mcp --timeout=300s
	@echo "✓ MCP examples up — crm-mcp behind the MCP gateway at /mcp/crm (and in the chat UI's Integrations menu)"

k3s-mcp-examples-down: ## Remove the example MCP server and API (the Keycloak clients stay)
	@kubectl -n ai-circus delete deployment,service crm-api crm-mcp --ignore-not-found

# The MCP catalog (mcp/catalog.yaml, ADR 0024) generates the gateway's routes, the chat UI's connections, each kit
# server's policy.yaml and the Keycloak exchange clients. PyYAML comes from libs/shared's environment.
MCP_CATALOG = uv run --project libs/shared --quiet python scripts/generate_mcp_catalog.py

mcp-catalog: ## Regenerate every file mcp/catalog.yaml decides (ADR 0024), then print who may run what. Commit both; `make k3s-mcp-catalog-apply` puts it on the cluster
	@$(MCP_CATALOG)
	@echo
	@$(MCP_CATALOG) --matrix

mcp-catalog-check: ## Fail if a file generated from mcp/catalog.yaml drifted (CI runs the same check in libs/shared's tests)
	@$(MCP_CATALOG) --check

# Level 3 (ADR 0025): one certificate authority per level-3 kit server and its API, files in infra/mcp-tls/ (gitignored).
MCP_TLS = uv run --project libs/mcp-kit --quiet python scripts/mcp_tls_certs.py

mcp-tls: ## Issue or renew the mutual-TLS certificates of every level-3 kit server and its API (infra/mcp-tls/, for docker compose)
	@$(MCP_TLS)

k3s-mcp-tls: ## Same, and apply them as one Secret per workload (<api>-tls, <service>-tls: only its own key). Restart the pair to load renewed certificates
	@$(MCP_TLS) --k8s

mcp-catalog-portal: ## OPTIONAL local portal over mcp/catalog.yaml (ADR 0024) at http://127.0.0.1:8040 (MCP_PORTAL_PORT): tick tools per group, add a server, review the diffs, publish (= make mcp-catalog). Never deploys or commits
	@$(MCP_CATALOG:generate_mcp_catalog.py=mcp_catalog_portal.py) --port "$${MCP_PORTAL_PORT:-8040}"

k3s-mcp-pseudonym: ## Audit lookup (ADR 0029): the pseudonym each API sees for a user (WHO=<username>), or who a pseudonym from an API's logs is (FIND=<uuid>). Needs Keycloak's admin access; never prints a salt
	@[ -n "$(WHO)$(FIND)" ] || { echo "❌ usage: make k3s-mcp-pseudonym WHO=<username> | FIND=<pseudonym>"; exit 1; }
	@python3 scripts/mcp_pseudonym.py --cluster "$(K3S_CLUSTER)" $(if $(WHO),--user "$(WHO)",--find "$(FIND)")

k3s-mcp-catalog-apply: ## Put mcp/catalog.yaml on the running cluster: sync Keycloak (exchange clients), Level 3 certificates, rebuild + import + restart llm-gateway and every deployed kit server (and restart its API), re-apply each deployed chat UI (Open WebUI, LibreChat)
	@$(MCP_CATALOG) --check
	@./scripts/k3s_portforward.sh status "$(K3S_CLUSTER)" >/dev/null 2>&1 || $(MAKE) --no-print-directory k3s-portforward
	@python3 scripts/chat_ui_identity.py --cluster "$(K3S_CLUSTER)"
	@./scripts/k3s_generate_secrets.sh >/dev/null
	@$(MCP_TLS) --k8s
	@kits="$$($(MCP_CATALOG) --kit-services)"; \
	for svc in llm-gateway $$kits; do \
		echo "── ai-circus/$$svc:local ──"; \
		docker build -q -f "services/$$svc/Dockerfile" -t "ai-circus/$$svc:local" . || exit 1; \
	done; \
	k3d image import $$(for svc in llm-gateway $$kits; do printf 'ai-circus/%s:local ' "$$svc"; done) -c "$(K3S_CLUSTER)" || exit 1; \
	for svc in llm-gateway $$kits $$($(MCP_CATALOG) --kit-apis); do \
		if kubectl -n ai-circus get deployment "$$svc" >/dev/null 2>&1; then \
			kubectl -n ai-circus rollout restart "deployment/$$svc" >/dev/null && \
			kubectl -n ai-circus rollout status "deployment/$$svc" --timeout=600s || exit 1; \
		fi; \
	done
	@if kubectl -n ai-circus get deployment open-webui >/dev/null 2>&1; then \
		kubectl apply -k k8s/chat-ui && kubectl -n ai-circus rollout status deployment/open-webui --timeout=900s; \
	fi
	@if kubectl -n ai-circus get deployment librechat >/dev/null 2>&1; then \
		kubectl apply -k k8s/chat-ui-librechat && kubectl -n ai-circus rollout status deployment/librechat --timeout=900s; \
	fi
	@echo "✓ catalog applied — gateway, kit servers, Keycloak and chat UIs follow mcp/catalog.yaml (a localhost:8033 forward needs a restart: make k3s-mcp-portforward)"

k3s-dl-train: ## Train ONE deep_learning scenario as an in-cluster Job (CPU budget unless the cluster exposes a GPU) — usage: make k3s-dl-train SCENARIO=<slug>
	@[ -n "$(SCENARIO)" ] || { echo "❌ usage: make k3s-dl-train SCENARIO=<deep_learning slug>"; exit 1; }
	@./scripts/k3s_dl_train.sh "$(SCENARIO)"

k3s-dl-train-nlp: ## In-cluster Job for the NLP scenario (see k3s-dl-train)
	@$(MAKE) --no-print-directory k3s-dl-train SCENARIO=$(DL_SCENARIO_NLP)

k3s-dl-train-cv: ## In-cluster Jobs for the computer-vision classifiers, one after the other (see k3s-dl-train)
	@for s in $$(echo "$(DL_SCENARIO_CV)" | tr ',' ' '); do $(MAKE) --no-print-directory k3s-dl-train SCENARIO=$$s || exit 1; done

k3s-dl-train-anomaly: ## In-cluster Jobs for the CV anomaly-detection scenarios, one after the other (see k3s-dl-train)
	@for s in $$(echo "$(DL_SCENARIO_ANOMALY)" | tr ',' ' '); do $(MAKE) --no-print-directory k3s-dl-train SCENARIO=$$s || exit 1; done

k3s-all-dl: k3s-all k3s-dl-build k3s-dl-up ## `k3s-all` + the Deep Learning overlay (no training — run `make dl-train` on a GPU host, or the admin console's Train button)
	@echo "✓ k3s cluster '$(K3S_CLUSTER)' is up with the Deep Learning overlay — train models with 'make dl-train' (GPU) if not done yet"

# ── Data Platform (optional tiers, docs/data-platform/) ──────────────────────
# Never part of k3s-all: each tier is a kustomize overlay under k8s/data-platform/<tier>/ with
# its own up/down target. Images are opt-in like the deep-learning ones.

K3S_DATA_IMAGES = data-ingest data-api data-transform
DATA_PRODUCT   ?= surf_retail

k3s-data-build: ## Build + import the Data Platform images (data-ingest, data-api, data-transform) into k3d
	@for svc in $(K3S_DATA_IMAGES); do \
		echo "── ai-circus/$$svc:local ──"; \
		docker build -f "services/$$svc/Dockerfile" -t "ai-circus/$$svc:local" . || exit 1; \
	done
	@k3d image import $(foreach svc,$(K3S_DATA_IMAGES),ai-circus/$(svc):local) -c "$(K3S_CLUSTER)"
	@echo "✓ Data Platform images built + imported"

k3s-data-core-up: ## Data Platform core tier: Kafka + data-ingest + data-api (+ the dbt CronJob) — k8s/data-platform/core
	@kubectl apply -k k8s/data-platform/core
	@kubectl -n ai-circus rollout status statefulset/kafka --timeout=180s
	@kubectl -n ai-circus rollout status deployment/data-ingest --timeout=240s
	@kubectl -n ai-circus rollout status deployment/data-api --timeout=240s
	@echo "✓ Data Platform core up — http://data-api.localhost/healthz; seed history with 'make k3s-data-seed'"

k3s-data-core-down: ## Remove the core tier; drops the CDC replication slot first (an undrained slot retains WAL)
	@kubectl -n ai-circus exec postgres-0 -- sh -c 'psql -U "$$POSTGRES_USER" -d data_sources -tAc \
		"SELECT pg_drop_replication_slot(slot_name) FROM pg_replication_slots WHERE slot_name = '"'"'data_ingest'"'"'"' \
		>/dev/null 2>&1 || true
	@kubectl delete -k k8s/data-platform/core --ignore-not-found

k3s-data-call: ## GET (or METHOD=POST BODY='{…}') a data-api path as the admin, e.g. P=/v1/surf_retail/overview — the key comes from .env, never echoed
	@[ -n "$(P)" ] || { echo "❌ usage: make k3s-data-call P=/v1/<slug>/<path>"; exit 1; }
	@curl -s -X "$(if $(METHOD),$(METHOD),GET)" -H "Authorization: Bearer $${ADMIN_API_KEY:-angel2026}" \
		-H 'Content-Type: application/json' $(if $(BODY),-d '$(BODY)') "$${DATA_API_URL:-http://data-api.localhost}$(P)"; echo

k3s-data-transform: ## Run the dbt build of every data product now (a Job from the data-transform CronJob) and show its log
	@job="data-transform-manual-$$(date +%s)"; \
	kubectl -n ai-circus create job "$$job" --from=cronjob/data-transform >/dev/null || exit 1; \
	for _ in $$(seq 1 180); do \
		state=$$(kubectl -n ai-circus get job "$$job" -o jsonpath='{.status.succeeded}{.status.failed}'); \
		[ -n "$$state" ] && break; sleep 5; \
	done; \
	kubectl -n ai-circus logs "job/$$job" --tail=40; \
	[ "$$(kubectl -n ai-circus get job "$$job" -o jsonpath='{.status.succeeded}')" = "1" ]

k3s-data-analytics-up: ## Data Platform analytics tier: Dagster + marts on ClickHouse (raises ClickHouse's limit to 1Gi, points data-api at ClickHouse, suspends the dbt CronJob)
	@kubectl -n ai-circus patch statefulset clickhouse --type=json \
		-p='[{"op":"replace","path":"/spec/template/spec/containers/0/resources/limits/memory","value":"1Gi"}]'
	@kubectl apply -k k8s/data-platform/analytics
	@kubectl -n ai-circus patch cronjob/data-transform -p '{"spec":{"suspend":true}}'
	@kubectl -n ai-circus set env deployment/data-api MARTS_ENGINE=clickhouse CLICKHOUSE_URL=http://clickhouse:8123 CLICKHOUSE_USER=clickhouse
	@kubectl -n ai-circus rollout status statefulset/clickhouse --timeout=240s
	@kubectl -n ai-circus rollout status deployment/dagster --timeout=420s
	@echo "✓ analytics tier up — http://dagster.localhost (admin basic auth); the first Postgres build chains a ClickHouse one"

k3s-data-analytics-down: ## Remove the analytics tier: data-api back on Postgres marts, CronJob resumed, ClickHouse limit restored
	@kubectl -n ai-circus set env deployment/data-api MARTS_ENGINE=postgres CLICKHOUSE_URL- CLICKHOUSE_USER-
	@kubectl -n ai-circus patch cronjob/data-transform -p '{"spec":{"suspend":false}}' || true
	@kubectl delete -k k8s/data-platform/analytics --ignore-not-found
	@kubectl -n ai-circus patch statefulset clickhouse --type=json \
		-p='[{"op":"replace","path":"/spec/template/spec/containers/0/resources/limits/memory","value":"512Mi"}]'

k3s-data-bi-up: ## Data Platform bi tier: Apache Superset (image from infra/superset/) + dashboards as code from each data product's bi/dashboards.yaml
	@docker build -q -t ai-circus/superset:local infra/superset >/dev/null
	@k3d image import ai-circus/superset:local -c "$(K3S_CLUSTER)" >/dev/null
	@kubectl -n ai-circus delete job superset-bi-sync --ignore-not-found >/dev/null
	@kubectl apply -k k8s/data-platform/bi
	@kubectl -n ai-circus rollout status deployment/superset --timeout=600s
	@kubectl -n ai-circus wait --for=condition=complete job/superset-bi-sync --timeout=600s
	@kubectl -n ai-circus logs job/superset-bi-sync --tail=5
	@echo "✓ bi tier up — http://superset.localhost (user admin, password SUPERSET_ADMIN_PASSWORD in .env)"

k3s-data-bi-sync: ## Re-run the dashboards-as-code Job (after editing a data product's bi/dashboards.yaml)
	@kubectl -n ai-circus delete job superset-bi-sync --ignore-not-found >/dev/null
	@kubectl apply -k k8s/data-platform/bi >/dev/null
	@kubectl -n ai-circus wait --for=condition=complete job/superset-bi-sync --timeout=600s
	@kubectl -n ai-circus logs job/superset-bi-sync --tail=5

k3s-data-bi-down: ## Remove the bi tier (Superset's metadata stays in Postgres database `superset`)
	@kubectl delete -k k8s/data-platform/bi --ignore-not-found

k3s-data-governance-up: ## Data Platform governance tier: OpenMetadata + search index, then the catalog-sync Job (image from infra/openmetadata-ingestion/)
	@docker build -q -t ai-circus/openmetadata-ingestion:local infra/openmetadata-ingestion >/dev/null
	@k3d image import ai-circus/openmetadata-ingestion:local -c "$(K3S_CLUSTER)" >/dev/null
	@kubectl -n ai-circus delete job catalog-sync --ignore-not-found >/dev/null
	@kubectl apply -k k8s/data-platform/governance
	@kubectl -n ai-circus rollout status statefulset/om-search --timeout=300s
	@kubectl -n ai-circus rollout status deployment/openmetadata --timeout=900s
	@kubectl -n ai-circus wait --for=condition=complete job/catalog-sync --timeout=1200s
	@kubectl -n ai-circus logs job/catalog-sync --tail=12 | grep -F "[catalog-sync]"
	@echo "✓ governance tier up — http://openmetadata.localhost (admin@open-metadata.org)"

k3s-data-catalog-sync: ## Re-run the catalogue sync (after a new data product, a dbt change or another tier coming up)
	@kubectl -n ai-circus delete job catalog-sync --ignore-not-found >/dev/null
	@kubectl apply -k k8s/data-platform/governance >/dev/null
	@kubectl -n ai-circus wait --for=condition=complete job/catalog-sync --timeout=1200s
	@kubectl -n ai-circus logs job/catalog-sync --tail=12 | grep -F "[catalog-sync]"

k3s-data-governance-down: ## Remove the governance tier (the catalogue stays in Postgres database `openmetadata`; the search index PVC is kept)
	@kubectl delete -k k8s/data-platform/governance --ignore-not-found

# Governance (docs/governance/): the optional OPA policy decision point for llm-gateway. Its
# policy and data are ConfigMaps built from infra/opa/; after the first `up`, point the gateway
# at it with POLICY_DECIDER=opa and POLICY_OPA_URL=http://opa:8181 (see docs/governance/policy.md).
k3s-governance-opa-up: ## Optional: deploy Open Policy Agent (policy from infra/opa/) as the gateway's policy decision point
	@docker image inspect openpolicyagent/opa:1.21.4-static >/dev/null 2>&1 || docker pull -q openpolicyagent/opa:1.21.4-static >/dev/null
	@k3d image import openpolicyagent/opa:1.21.4-static -c "$(K3S_CLUSTER)" >/dev/null
	@kubectl -n ai-circus create configmap opa-policy --from-file=aicircus.rego=infra/opa/policy/aicircus.rego --dry-run=client -o yaml | kubectl apply -f -
	@kubectl -n ai-circus create configmap opa-data --from-file=data.json=infra/opa/data/data.json --dry-run=client -o yaml | kubectl apply -f -
	@kubectl apply -k k8s/governance
	@kubectl -n ai-circus rollout restart deployment/opa >/dev/null
	@kubectl -n ai-circus rollout status deployment/opa --timeout=120s

k3s-governance-opa-down: ## Remove the optional OPA policy decision point (and its ConfigMaps)
	@kubectl delete -k k8s/governance --ignore-not-found
	@kubectl -n ai-circus delete configmap opa-policy opa-data --ignore-not-found

k3s-governance-opa-test: ## Run the reference Rego policy's unit tests (needs only Docker)
	@docker run --rm -v "$(CURDIR)/infra/opa:/policies:ro" openpolicyagent/opa:1.21.4-static test /policies -v

# Optional observability lab bundle (ADR 0015, observability/) — only for clusters with no platform stack.
# Up: deploy it, then point every service at its collector (one shared-config key, added by patch so a
# later `kubectl apply -k k8s/base` keeps it) and restart them. Down: the reverse, then delete it.
OBS_ENDPOINT ?= http://otel-collector.observability:4318
OBS_SERVICES ?= prediction assistant rag-agent form-agent platform-registry data-platform-manager llm-gateway agui-voice dl-inference data-api data-ingest crm-api crm-mcp
# The optional chat UI (ADR 0021) reads its own variables, not shared-config: switched on and off here (gRPC, port 4317).
OBS_CHAT_UI_ENV = ENABLE_OTEL=true ENABLE_OTEL_TRACES=true OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.observability:4317 OTEL_EXPORTER_OTLP_INSECURE=true
# LibreChat's own OpenTelemetry (docs/adr/0027): traces only (its logs reach Loki from stdout), over OTLP/HTTP. Its HTTP
# spans carry no headers and redacted query strings; its MCP calls pass the trace context on to the gateway.
OBS_LIBRECHAT_ENV = OTEL_TRACING_ENABLED=true OTEL_SERVICE_NAME=librechat OTEL_EXPORTER_OTLP_ENDPOINT=$(OBS_ENDPOINT) OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OBS_WORKLOADS = daemonset/otel-collector deployment/victoriametrics deployment/vmalert deployment/loki deployment/tempo deployment/grafana

k3s-obs-up: ## OPTIONAL observability lab bundle (~1 GiB): collector, VictoriaMetrics+vmalert, Loki, Tempo, Grafana at http://grafana.localhost; every service starts exporting to it
	@kubectl get namespace observability >/dev/null 2>&1 || kubectl create namespace observability >/dev/null
	@kubectl -n observability get secret grafana-admin >/dev/null 2>&1 || \
		kubectl -n observability create secret generic grafana-admin --from-literal=password="$$(openssl rand -hex 16)" >/dev/null
	@kubectl apply -k observability >/dev/null && echo "✓ bundle applied"
	@kubectl -n observability rollout restart $(OBS_WORKLOADS) >/dev/null
	@for w in $(OBS_WORKLOADS); do kubectl -n observability rollout status $$w --timeout=300s >/dev/null || exit 1; done
	@echo "✓ bundle ready"
	@kubectl -n ai-circus patch configmap shared-config --type merge \
		-p '{"data":{"OTEL_EXPORTER_OTLP_ENDPOINT":"$(OBS_ENDPOINT)"}}' >/dev/null
	@$(MAKE) --no-print-directory k3s-obs-restart
	@if kubectl -n ai-circus get deployment/open-webui >/dev/null 2>&1; then \
		kubectl -n ai-circus set env deployment/open-webui $(OBS_CHAT_UI_ENV) >/dev/null && \
		kubectl -n ai-circus rollout status deployment/open-webui --timeout=600s >/dev/null && echo "✓ open-webui traces too"; fi
	@if kubectl -n ai-circus get deployment/librechat >/dev/null 2>&1; then \
		kubectl -n ai-circus set env deployment/librechat $(OBS_LIBRECHAT_ENV) >/dev/null && \
		kubectl -n ai-circus rollout status deployment/librechat --timeout=600s >/dev/null && echo "✓ librechat traces too"; fi
	@echo "✓ services export to $(OBS_ENDPOINT) — Grafana: http://grafana.localhost (anonymous = Viewer; admin password:"
	@echo "  kubectl -n observability get secret grafana-admin -o jsonpath='{.data.password}' | base64 -d)"

k3s-obs-down: ## Undo k3s-obs-up: services stop exporting, then the bundle and its (24 h of) data are deleted
	@kubectl -n ai-circus patch configmap shared-config --type json \
		-p '[{"op":"remove","path":"/data/OTEL_EXPORTER_OTLP_ENDPOINT"}]' >/dev/null 2>&1 || true
	@$(MAKE) --no-print-directory k3s-obs-restart
	@if kubectl -n ai-circus get deployment/open-webui >/dev/null 2>&1; then \
		kubectl -n ai-circus set env deployment/open-webui ENABLE_OTEL- ENABLE_OTEL_TRACES- OTEL_EXPORTER_OTLP_ENDPOINT- OTEL_EXPORTER_OTLP_INSECURE- >/dev/null; fi
	@if kubectl -n ai-circus get deployment/librechat >/dev/null 2>&1; then \
		kubectl -n ai-circus set env deployment/librechat OTEL_TRACING_ENABLED- OTEL_SERVICE_NAME- OTEL_EXPORTER_OTLP_ENDPOINT- OTEL_EXPORTER_OTLP_PROTOCOL- >/dev/null; fi
	@kubectl delete -k observability --ignore-not-found >/dev/null && echo "✓ observability bundle removed"

k3s-obs-restart: ## (internal) Restart each running OBS_SERVICES Deployment in turn so it rereads shared-config
	@# One at a time, each waited for: restarting them all at once doubles every pod's memory for a while,
	@# more than a 16 GB laptop has. A service that is slow to come back is reported, never fatal.
	@for d in $(OBS_SERVICES); do \
		r=$$(kubectl -n ai-circus get deployment $$d -o jsonpath='{.spec.replicas}' 2>/dev/null); \
		[ -n "$$r" ] && [ "$$r" != "0" ] || continue; \
		kubectl -n ai-circus rollout restart deployment/$$d >/dev/null; \
		if kubectl -n ai-circus rollout status deployment/$$d --timeout=300s >/dev/null 2>&1; then echo "  ↻ $$d"; \
		else echo "  ⚠ $$d not Ready after 5 min — check it with: kubectl -n ai-circus get pods -l app=$$d"; fi; \
	done

# Everything a data showcase never touches, scaled to 0 by `k3s-data-showcase` (on top of
# K3S_DEMO_SKIP): the other kinds' services. The assistant, llm-gateway and Keycloak stay.
K3S_DATA_SHOWCASE_SKIP ?= prediction rag-agent form-agent dl-inference
K3S_DATA_SHOWCASE_SKIP_STS ?= qdrant

k3s-data-showcase: ## The whole Data Platform on one laptop: scale AI-only pods to 0 (k3s-demo + other kinds), then core + analytics + bi + governance
	@$(MAKE) --no-print-directory k3s-lite K3S_LITE_SKIP="$(K3S_DEMO_SKIP)"
	@for d in $(K3S_DATA_SHOWCASE_SKIP); do \
		kubectl -n ai-circus scale deployment/$$d --replicas=0 >/dev/null 2>&1 || true; done
	@for s in $(K3S_DATA_SHOWCASE_SKIP_STS); do kubectl -n ai-circus scale statefulset/$$s --replicas=0 >/dev/null; done
	@$(MAKE) --no-print-directory k3s-data-core-up k3s-data-analytics-up k3s-data-bi-up k3s-data-governance-up
	@kubectl top node 2>/dev/null || true
	@echo "✓ data showcase up — http://aiopen.localhost → Angel's Surf Co. — Data Platform"

k3s-data-showcase-off: ## Undo k3s-data-showcase: drop governance + bi + analytics, bring the other kinds' pods back
	@$(MAKE) --no-print-directory k3s-data-governance-down k3s-data-bi-down k3s-data-analytics-down
	@for s in $(K3S_DATA_SHOWCASE_SKIP_STS); do kubectl -n ai-circus scale statefulset/$$s --replicas=1 >/dev/null; done
	@for d in $(K3S_DATA_SHOWCASE_SKIP); do \
		kubectl -n ai-circus scale deployment/$$d --replicas=1 >/dev/null 2>&1 || true; done
	@$(MAKE) --no-print-directory k3s-demo-off

# `k3s-data-demo`: the typical multi-scenario demo WITH the data platform — every scenario kind
# (tabular, RAG, forms, data) plus the core, analytics and bi tiers; governance (OpenMetadata, the
# heaviest tier), MLflow and voice stay off. Deep learning is optional and separate (`k3s-dl-up`).
K3S_DATA_DEMO_OFF ?= mlflow agui-voice
k3s-data-demo: ## Everything a multi-scenario demo needs, data included, minus governance, MLflow and voice: scenarios of every kind + data core + analytics + bi (needs a running cluster; undo with k3s-data-demo-off)
	@$(MAKE) --no-print-directory k3s-data-governance-down
	@for s in qdrant clickhouse; do kubectl -n ai-circus scale statefulset/$$s --replicas=1 >/dev/null || exit 1; done
	@for d in prediction rag-agent form-agent langfuse-web langfuse-worker data-platform-manager; do \
		kubectl -n ai-circus scale deployment/$$d --replicas=1 >/dev/null || exit 1; done
	@$(MAKE) --no-print-directory k3s-lite K3S_LITE_SKIP="$(K3S_DATA_DEMO_OFF)"
	@$(MAKE) --no-print-directory k3s-data-core-up k3s-data-analytics-up k3s-data-bi-up
	@kubectl top node 2>/dev/null || true
	@echo "✓ data demo up (no governance, MLflow or voice) — http://aiopen.localhost; 'make k3s-wait' to confirm every pod is Ready; first time: make k3s-pipeline, k3s-data-seed, k3s-data-ml"

k3s-data-demo-off: ## Undo k3s-data-demo: drop bi + analytics (the core tier stays), bring MLflow and voice back
	@$(MAKE) --no-print-directory k3s-data-bi-down k3s-data-analytics-down
	@$(MAKE) --no-print-directory k3s-full K3S_LITE_SKIP="$(K3S_DATA_DEMO_OFF)"

k3s-data-reset: ## Drop ALL data of one data product (every tenant): warehouse schemas, lake, landing, ERP, topics — then `make k3s-data-seed`
	@./scripts/k3s_data_reset.sh "$(DATA_PRODUCT)" "$(if $(DATA_DOMAIN),$(DATA_DOMAIN),retail)"

k3s-data-seed: ## Generate the data product's history through the real pipeline (DATA_PRODUCT=surf_retail, DAYS=…) into the fallback org
	@./scripts/k3s_data_seed.sh "$(DATA_PRODUCT)" "$(DAYS)"

k3s-data-ml: ## Train the tabular_ml scenarios the data product exports (ml_exports) — after a transform has built its feature marts
	@./scripts/k3s_ml_train.sh "$(if $(ML_SCENARIOS),$(ML_SCENARIOS),surf_ml)"

k3s-data-seed-lite: ## Same with one year of history (laptops short of memory/disk; the default is the scenario's history_days)
	@./scripts/k3s_data_seed.sh "$(DATA_PRODUCT)" 365

# ── Scaffolding ───────────────────────────────────────────────────────────────

new-service: ## Scaffold a new backend service from ai-circus-template (usage: make new-service NAME=my-service)
	@[ -n "$(NAME)" ] || { echo "❌ usage: make new-service NAME=my-service"; exit 1; }
	@./scripts/new_service.sh "$(NAME)"

sync-shared: ## Rebuild+reinstall libs/shared in every service (run after editing libs/shared)
	@for dir in services/*/; do \
		if [ -f "$$dir/pyproject.toml" ]; then \
			echo "── $$dir ──"; \
			(cd "$$dir" && uv sync --reinstall-package ai-circus-shared) || exit 1; \
		fi; \
	done
	@echo "✓ ai-circus-shared resynced everywhere"

# ── QA across services ────────────────────────────────────────────────────────

check-all: ## Lint+test libs/shared and libs/mcp-kit, then run `make check` inside every generated service
	@echo "── libs/shared ──"
	@cd libs/shared && uv run ruff check -q src tests && uv run ruff format -q --check src tests && uv run pytest -q
	@echo "── libs/mcp-kit ──"
	@cd libs/mcp-kit && uv run ruff check -q src tests && uv run ruff format -q --check src tests && uv run pytest -q
	@for dir in services/*/; do \
		if [ -f "$$dir/Makefile" ]; then \
			echo "── $$dir ──"; \
			$(MAKE) -C "$$dir" check || exit 1; \
		fi; \
	done
	@echo "✓ all services checked"

clean: ## Remove containers, volumes, and per-service build artifacts
	@docker compose down -v
	@for dir in services/*/ ui-react; do \
		[ -f "$$dir/Makefile" ] && $(MAKE) -C "$$dir" clean 2>/dev/null || true; \
	done
